---
interface Props {
  color?: string;
  fill?: string;
  size?: number;
}
const { color = "#f1912a", fill = "#fdf3cc", size = 26 } = Astro.props;
const scale = size / 26;
---
<g transform={`scale(${scale})`}>
  <circle cx="13" cy="7" r="6.5" fill={fill} stroke={color} stroke-width="2.5" />
  <path d="M 1 27 C 1 17 5 14 13 14 C 21 14 25 17 25 27 Z" fill={fill} stroke={color} stroke-width="2.5" stroke-linejoin="round" />
</g>
