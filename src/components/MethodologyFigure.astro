---
// Full SVG vector recreation of sources/visualizations/hybrid/Iterative_Hybrid_Coding_2.png
// (= Figure 1 in the paper).
// Rebuilt as clean, standalone vector shapes matching the exact paper geometry,
// with interactive hover highlights and tooltips for web companion exploration.
import PersonIcon from "./PersonIcon.astro";

interface Component {
  id: string;
  label: string;
  detail: string;
}

const components: Component[] = [
  { id: "limitations", label: "Limitations Section", detail: "Input: the raw text of a paper's Limitations section, e.g. “This study is limited by …”" },
  { id: "segmentation", label: "Semantic Unit Segmentation", detail: "Gemini 2.5 Flash splits the section into individual sentences (s₁, s₂, …), each coded independently next." },
  { id: "deductive", label: "Deductive coding", detail: "Gemini 3.1 Pro assigns existing codes from the current codebook Cₜ₋₁ (e.g. s₁ → Code 1, s₂ → Code 3)." },
  { id: "inductive", label: "Inductive coding", detail: "Where no existing code fits, the model proposes a new one (e.g. s₁ → “Poor data”) instead of forcing a bad match." },
  { id: "handling", label: "Handling New Codes", detail: "Inductively-proposed codes are clustered, a definition is recommended, a researcher reviews it, then applies it to the codebook — the only step with a human in the loop." },
  { id: "annotated", label: "Annotated Data", detail: "Output: each sentence's final code list, e.g. s₁ → [Code 1, Code 4], s₂ → [Code 3]." },
  { id: "updated-codebook", label: "Updated Codebook", detail: "The codebook after this paper's new code (Code 4) is applied — this becomes Cₜ₋₁ for the next paper/iteration." },
];
const byId = Object.fromEntries(components.map((c) => [c.id, c])) as Record<string, Component>;

const C = {
  canvasBg: "#ffffff",
  outerPanel: "#e6e6e6",
  innerPanel: "#cccccc",
  tab: "#666666",
  seg: "#ecf3fe",
  segInner: "#7db0ff",
  hybrid: "#d8e8d4",
  hybridInner: "#a0cf76",
  handling: "#fbeedc",
  handlingTableBorder: "#cb8d59",
  annotated: "#efd3d2",
  code4Bg1: "#f49fcd",
  code4Bg2: "#f9cee7",
  personStroke: "#f1912a",
  personFill: "#fdf3cc",
  border: "#000000",
  text: "#000000",
};
---
<div class="methodology-figure-wrap">
  <svg viewBox="0 0 1691 672" role="img" aria-labelledby="methodology-svg-title" class="methodology-svg">
    <title id="methodology-svg-title">Iterative Hybrid Coding pipeline diagram</title>
    <defs>
      <marker id="arrow" viewBox="0 0 10 10" refX="7" refY="5" markerWidth="8" markerHeight="8" orient="auto-start-reverse">
        <path d="M 0 1.2 L 8.5 5 L 0 8.8 z" fill="#000000" />
      </marker>
    </defs>

    <!-- Canvas background -->
    <rect width="1691" height="672" fill={C.canvasBg} />

    <!-- Container: Iteration t (#e6e6e6) -->
    <rect x="272" y="10" width="143" height="47" rx="10" fill={C.tab} />
    <text x="343.5" y="41" text-anchor="middle" class="tab-txt">Iteration <tspan font-style="italic">t</tspan></text>
    <rect x="272" y="57" width="1412" height="529" rx="18" fill={C.outerPanel} />

    <!-- Container: Paper i (#cccccc) - L-shaped body -->
    <rect x="295" y="82" width="143" height="47" rx="10" fill={C.tab} />
    <text x="366.5" y="113" text-anchor="middle" class="tab-txt">Paper <tspan font-style="italic">i</tspan></text>
    <path d="M 313 129 L 1643 129 A 18 18 0 0 1 1661 147 L 1661 272 L 1145 272 L 1145 542 A 18 18 0 0 1 1127 560 L 313 560 A 18 18 0 0 1 295 542 L 295 147 A 18 18 0 0 1 313 129 Z" fill={C.innerPanel} />

    <!-- Block 1: Limitations Section (folded doc) -->
    <g class="interactive-stage" data-stage-id="limitations">
      <rect class="zone-hit" tabindex="0" role="button" aria-label={`${byId.limitations.label}: ${byId.limitations.detail}`} x="326" y="150" width="156" height="210" fill="#000000" opacity="0.0001" />
      <g class="zone-visual">
        <path d="M 330 155 L 456 155 L 478 177 L 478 355 L 330 355 Z" fill="#ffffff" stroke={C.border} stroke-width="2.5" />
        <path d="M 456 155 L 456 177 L 478 177 Z" fill="#ffffff" stroke={C.border} stroke-width="2.5" stroke-linejoin="round" />
        <text x="404" y="208" text-anchor="middle" class="bold-underlined title-lg">Limitations</text>
        <text x="404" y="234" text-anchor="middle" class="bold-underlined title-lg">Section</text>
        <text x="404" y="285" text-anchor="middle" class="body-txt" font-size="16">“This study is</text>
        <text x="404" y="310" text-anchor="middle" class="body-txt" font-size="16">limited by…”</text>
      </g>
    </g>

    <!-- Block 2: Semantic Unit Segmentation -->
    <g class="interactive-stage" data-stage-id="segmentation">
      <rect class="zone-hit" tabindex="0" role="button" aria-label={`${byId.segmentation.label}: ${byId.segmentation.detail}`} x="532" y="115" width="210" height="282" fill="#000000" opacity="0.0001" />
      <g class="zone-visual">
        <rect x="536" y="119" width="202" height="274" rx="24" fill={C.seg} />
        <text x="637" y="152" text-anchor="middle" class="bold-underlined title-md">Semantic Unit</text>
        <text x="637" y="176" text-anchor="middle" class="bold-underlined title-md">Segmentation</text>
        <!-- Pill 1: s1 -->
        <rect x="554" y="195" width="166" height="66" rx="8" fill={C.segInner} />
        <text x="566" y="222" class="body-txt">s<tspan baseline-shift="sub" font-size="11">1</tspan> = “This study</text>
        <text x="566" y="246" class="body-txt">is limited by …”</text>
        <!-- Pill 2: s2 -->
        <rect x="554" y="275" width="166" height="66" rx="8" fill={C.segInner} />
        <text x="566" y="302" class="body-txt">s<tspan baseline-shift="sub" font-size="11">2</tspan> = “Moreover,</text>
        <text x="566" y="326" class="body-txt">our model is …”</text>
      </g>
    </g>

    <!-- Block 3: Automatic Hybrid Coding Container -->
    <rect x="786" y="118" width="334" height="396" rx="24" fill={C.hybrid} />
    <text x="848" y="295" text-anchor="middle" class="bold-underlined title-lg">Automatic</text>
    <text x="848" y="322" text-anchor="middle" class="bold-underlined title-lg">Hybrid</text>
    <text x="848" y="349" text-anchor="middle" class="bold-underlined title-lg">Coding</text>

    <!-- Branch lines to Deductive & Inductive -->
    <polyline points="846,260 846,225 931,225" fill="none" stroke="#000000" stroke-width="2.5" marker-end="url(#arrow)" />
    <polyline points="846,370 846,405 931,405" fill="none" stroke="#000000" stroke-width="2.5" marker-end="url(#arrow)" />

    <!-- Deductive Box (interactive) -->
    <g class="interactive-stage" data-stage-id="deductive">
      <rect class="zone-hit" tabindex="0" role="button" aria-label={`${byId.deductive.label}: ${byId.deductive.detail}`} x="927" y="139" width="176" height="165" fill="#000000" opacity="0.0001" />
      <g class="zone-visual">
        <rect x="931" y="143" width="168" height="157" rx="16" fill={C.hybridInner} />
        <text x="1015" y="172" text-anchor="middle" class="bold-underlined title-md">Deductive</text>
        <text x="1015" y="198" text-anchor="middle" class="sub-label">Assign existing</text>
        <text x="1015" y="219" text-anchor="middle" class="sub-label">codes</text>
        <text x="946" y="254" class="body-txt">s<tspan baseline-shift="sub" font-size="11">1</tspan> → Code 1</text>
        <text x="946" y="282" class="body-txt">s<tspan baseline-shift="sub" font-size="11">2</tspan> → Code 3</text>
      </g>
    </g>

    <!-- Inductive Box (interactive) -->
    <g class="interactive-stage" data-stage-id="inductive">
      <rect class="zone-hit" tabindex="0" role="button" aria-label={`${byId.inductive.label}: ${byId.inductive.detail}`} x="927" y="316" width="176" height="165" fill="#000000" opacity="0.0001" />
      <g class="zone-visual">
        <rect x="931" y="320" width="168" height="157" rx="16" fill={C.hybridInner} />
        <text x="1015" y="348" text-anchor="middle" class="bold-underlined title-md">Inductive</text>
        <text x="1015" y="374" text-anchor="middle" class="sub-label">Assign new</text>
        <text x="1015" y="395" text-anchor="middle" class="sub-label">codes</text>
        <text x="946" y="438" class="body-txt">s<tspan baseline-shift="sub" font-size="11">1</tspan> → Poor data</text>
      </g>
    </g>

    <!-- Block 4: Annotated Data (interactive) -->
    <g class="interactive-stage" data-stage-id="annotated">
      <rect class="zone-hit" tabindex="0" role="button" aria-label={`${byId.annotated.label}: ${byId.annotated.detail}`} x="1402" y="114" width="248" height="140" fill="#000000" opacity="0.0001" />
      <g class="zone-visual">
        <rect x="1406" y="118" width="240" height="132" rx="20" fill={C.annotated} />
        <text x="1526" y="152" text-anchor="middle" class="bold-underlined title-lg">Annotated Data</text>
        <text x="1426" y="194" class="body-txt" font-size="16">s<tspan baseline-shift="sub" font-size="11">1</tspan> → [Code 1, <tspan font-weight="700">Code 4</tspan>]</text>
        <text x="1426" y="224" class="body-txt" font-size="16">s<tspan baseline-shift="sub" font-size="11">2</tspan> → [Code 3]</text>
      </g>
    </g>

    <!-- Block 5: Handling New Codes (interactive) -->
    <g class="interactive-stage" data-stage-id="handling">
      <rect class="zone-hit" tabindex="0" role="button" aria-label={`${byId.handling.label}: ${byId.handling.detail}`} x="1165" y="285" width="216" height="282" fill="#000000" opacity="0.0001" />
      <g class="zone-visual">
        <rect x="1171" y="290" width="204" height="272" rx="20" fill={C.handling} />
        <text x="1273" y="322" text-anchor="middle" class="bold-underlined title-md">Handling New</text>
        <text x="1273" y="346" text-anchor="middle" class="bold-underlined title-md">Codes</text>

        <!-- 4-row list -->
        <rect x="1195" y="360" width="156" height="180" fill={C.handling} stroke={C.handlingTableBorder} stroke-width="1.5" />
        <line x1="1195" y1="405" x2="1351" y2="405" stroke={C.handlingTableBorder} stroke-width="1.5" />
        <line x1="1195" y1="450" x2="1351" y2="450" stroke={C.handlingTableBorder} stroke-width="1.5" />
        <line x1="1195" y1="495" x2="1351" y2="495" stroke={C.handlingTableBorder} stroke-width="1.5" />
        <text x="1273" y="389" text-anchor="middle" class="body-txt" font-size="16">Cluster</text>
        <text x="1273" y="434" text-anchor="middle" class="body-txt" font-size="16">Recommend</text>
        <text x="1273" y="479" text-anchor="middle" class="body-txt" font-size="16">Human Review</text>
        <text x="1273" y="524" text-anchor="middle" class="body-txt" font-size="16">Apply</text>

        <!-- Person Icon for Human Review -->
        <g transform="translate(1168, 458)">
          <PersonIcon color={C.personStroke} fill={C.personFill} />
        </g>
      </g>
    </g>

    <!-- Block 6: Codebook Tables -->
    <!-- Table 1: Initial Codebook: C_0 -->
    <g id="initial-codebook">
      <text x="16" y="398" class="bold-underlined title-sm">Initial Codebook: <tspan font-style="italic">C</tspan><tspan font-style="italic" font-size="13" dy="4">0</tspan></text>
      <g transform="translate(16, 412)">
        <rect x="0" y="0" width="88" height="29" fill="#ffffff" stroke={C.border} stroke-width="2" />
        <rect x="88" y="0" width="88" height="29" fill="#ffffff" stroke={C.border} stroke-width="2" />
        <text x="44" y="20" text-anchor="middle" class="table-cell-txt">Code 1</text>
        <text x="132" y="20" text-anchor="middle" class="table-cell-txt">Defn. 1</text>

        <rect x="0" y="29" width="88" height="29" fill="#ffffff" stroke={C.border} stroke-width="2" />
        <rect x="88" y="29" width="88" height="29" fill="#ffffff" stroke={C.border} stroke-width="2" />
        <text x="44" y="49" text-anchor="middle" class="table-cell-txt">Code 2</text>
        <text x="132" y="49" text-anchor="middle" class="table-cell-txt">Defn. 2</text>

        <rect x="0" y="58" width="88" height="29" fill="#ffffff" stroke={C.border} stroke-width="2" />
        <rect x="88" y="58" width="88" height="29" fill="#ffffff" stroke={C.border} stroke-width="2" />
        <text x="44" y="78" text-anchor="middle" class="table-cell-txt">Code 3</text>
        <text x="132" y="78" text-anchor="middle" class="table-cell-txt">Defn. 3</text>
      </g>
      <!-- Person Icon for Initial Codebook -->
      <g transform="translate(178, 478)">
        <PersonIcon color={C.personStroke} fill={C.personFill} />
      </g>
    </g>

    <!-- Table 2: Codebook: C_{t-1} -->
    <g id="codebook-prev">
      <text x="320" y="398" class="bold-underlined title-sm">Codebook: <tspan font-style="italic">C</tspan><tspan font-style="italic" font-size="13" dy="4">t-1</tspan></text>
      <g transform="translate(320, 412)">
        <rect x="0" y="0" width="88" height="29" fill="#ffffff" stroke={C.border} stroke-width="2" />
        <rect x="88" y="0" width="88" height="29" fill="#ffffff" stroke={C.border} stroke-width="2" />
        <text x="44" y="20" text-anchor="middle" class="table-cell-txt">Code 1</text>
        <text x="132" y="20" text-anchor="middle" class="table-cell-txt">Defn. 1</text>

        <rect x="0" y="29" width="88" height="29" fill="#ffffff" stroke={C.border} stroke-width="2" />
        <rect x="88" y="29" width="88" height="29" fill="#ffffff" stroke={C.border} stroke-width="2" />
        <text x="44" y="49" text-anchor="middle" class="table-cell-txt">Code 2</text>
        <text x="132" y="49" text-anchor="middle" class="table-cell-txt">Defn. 2</text>

        <rect x="0" y="58" width="88" height="29" fill="#ffffff" stroke={C.border} stroke-width="2" />
        <rect x="88" y="58" width="88" height="29" fill="#ffffff" stroke={C.border} stroke-width="2" />
        <text x="44" y="78" text-anchor="middle" class="table-cell-txt">Code 3</text>
        <text x="132" y="78" text-anchor="middle" class="table-cell-txt">Defn. 3</text>
      </g>
    </g>

    <!-- Table 3: Updated Codebook: C_t (interactive) -->
    <g class="interactive-stage" data-stage-id="updated-codebook">
      <rect class="zone-hit" tabindex="0" role="button" aria-label={`${byId["updated-codebook"].label}: ${byId["updated-codebook"].detail}`} x="1435" y="390" width="196" height="142" fill="#000000" opacity="0.0001" />
      <g class="zone-visual">
        <text x="1440" y="398" class="bold-underlined title-sm">Updated Codebook: <tspan font-style="italic">C</tspan><tspan font-style="italic" font-size="13" dy="4">t</tspan></text>
        <g transform="translate(1440, 412)">
          <rect x="0" y="0" width="93" height="29" fill="#ffffff" stroke={C.border} stroke-width="2" />
          <rect x="93" y="0" width="93" height="29" fill="#ffffff" stroke={C.border} stroke-width="2" />
          <text x="46.5" y="20" text-anchor="middle" class="table-cell-txt">Code 1</text>
          <text x="139.5" y="20" text-anchor="middle" class="table-cell-txt">Defn. 1</text>

          <rect x="0" y="29" width="93" height="29" fill="#ffffff" stroke={C.border} stroke-width="2" />
          <rect x="93" y="29" width="93" height="29" fill="#ffffff" stroke={C.border} stroke-width="2" />
          <text x="46.5" y="49" text-anchor="middle" class="table-cell-txt">Code 2</text>
          <text x="139.5" y="49" text-anchor="middle" class="table-cell-txt">Defn. 2</text>

          <rect x="0" y="58" width="93" height="29" fill="#ffffff" stroke={C.border} stroke-width="2" />
          <rect x="93" y="58" width="93" height="29" fill="#ffffff" stroke={C.border} stroke-width="2" />
          <text x="46.5" y="78" text-anchor="middle" class="table-cell-txt">Code 3</text>
          <text x="139.5" y="78" text-anchor="middle" class="table-cell-txt">Defn. 3</text>

          <!-- Row 4 (highlighted new code) -->
          <rect x="0" y="87" width="93" height="29" fill={C.code4Bg1} stroke={C.border} stroke-width="2" />
          <rect x="93" y="87" width="93" height="29" fill={C.code4Bg2} stroke={C.border} stroke-width="2" />
          <text x="46.5" y="107" text-anchor="middle" class="table-cell-txt" font-weight="500">Code 4</text>
          <text x="139.5" y="107" text-anchor="middle" class="table-cell-txt" font-weight="500">Defn. 4</text>
        </g>
      </g>
    </g>

    <!-- Block 7: Loopback "Used in the next iteration" -->
    <g id="loopback">
      <rect x="660" y="608" width="530" height="50" rx="16" fill="#ffffff" stroke="#000000" stroke-width="3" stroke-dasharray="3,3" />
      <text x="925" y="641" text-anchor="middle" class="body-txt" font-size="20">Used in the next iteration</text>
      <!-- Line from Updated Codebook to loopback pill -->
      <polyline points="1533,528 1533,633 1190,633" fill="none" stroke="#000000" stroke-width="2.5" />
      <!-- Line from loopback pill to Codebook C_{t-1} -->
      <polyline points="660,633 402,633 402,499" fill="none" stroke="#000000" stroke-width="2.5" marker-end="url(#arrow)" />
    </g>

    <!-- All Inter-Block Connecting Arrows -->
    <g class="arrows">
      <!-- Initial Codebook -> Codebook C_{t-1} -->
      <line x1="192" y1="462.5" x2="320" y2="462.5" stroke="#000000" stroke-width="2.5" marker-end="url(#arrow)" />
      <!-- Codebook C_{t-1} -> Automatic Hybrid Coding -->
      <line x1="496" y1="462.5" x2="786" y2="462.5" stroke="#000000" stroke-width="2.5" marker-end="url(#arrow)" />
      <!-- Limitations Doc -> Semantic Unit Segmentation -->
      <line x1="478" y1="266.5" x2="536" y2="266.5" stroke="#000000" stroke-width="2.5" marker-end="url(#arrow)" />
      <!-- Semantic Unit Segmentation -> Automatic Hybrid Coding -->
      <line x1="738" y1="262.5" x2="786" y2="262.5" stroke="#000000" stroke-width="2.5" marker-end="url(#arrow)" />
      <!-- Deductive -> Annotated Data (straight line above Handling New Codes) -->
      <line x1="1099" y1="183" x2="1406" y2="183" stroke="#000000" stroke-width="2.5" marker-end="url(#arrow)" />
      <!-- Inductive -> Handling New Codes -->
      <line x1="1099" y1="410" x2="1171" y2="410" stroke="#000000" stroke-width="2.5" marker-end="url(#arrow)" />
      <!-- Handling New Codes -> Annotated Data (right then up) -->
      <polyline points="1375,343 1530,343 1530,250" fill="none" stroke="#000000" stroke-width="2.5" marker-end="url(#arrow)" />
      <!-- Handling New Codes -> Updated Codebook C_t -->
      <line x1="1375" y1="489" x2="1440" y2="489" stroke="#000000" stroke-width="2.5" marker-end="url(#arrow)" />
    </g>
  </svg>

  <!-- High z-index floating HTML tooltip: immune to SVG paint-order clipping -->
  <div id="methodology-tooltip" class="methodology-html-tooltip" role="tooltip" aria-hidden="true" style="display: none;">
    <div class="methodology-tooltip-title" id="methodology-tooltip-title"></div>
    <div class="methodology-tooltip-detail" id="methodology-tooltip-detail"></div>
  </div>

  <script type="application/json" id="methodology-data" set:html={JSON.stringify(byId)} />
</div>

<p class="methodology-hint">Hover or tap a stage of the diagram for details.</p>

<script>
  function initMethodologyTooltips() {
    const wrap = document.querySelector('.methodology-figure-wrap') as HTMLElement | null;
    const tooltip = document.getElementById('methodology-tooltip');
    const titleEl = document.getElementById('methodology-tooltip-title');
    const detailEl = document.getElementById('methodology-tooltip-detail');
    const dataEl = document.getElementById('methodology-data');
    if (!wrap || !tooltip || !titleEl || !detailEl || !dataEl) return;

    let stageData: Record<string, { label: string; detail: string }> = {};
    try {
      stageData = JSON.parse(dataEl.textContent || '{}');
    } catch (e) {
      console.error(e);
    }

    const stages = wrap.querySelectorAll('.interactive-stage');

    function showTooltip(stage: Element) {
      const stageId = stage.getAttribute('data-stage-id');
      if (!stageId || !stageData[stageId] || !tooltip || !titleEl || !detailEl || !wrap) return;

      const { label, detail } = stageData[stageId];
      titleEl.textContent = label;
      detailEl.textContent = detail;

      const wrapRect = wrap.getBoundingClientRect();
      const hit = stage.querySelector('.zone-hit') || stage;
      const stageRect = hit.getBoundingClientRect();

      const stageCenterX = stageRect.left - wrapRect.left + stageRect.width / 2;
      const stageTopY = stageRect.top - wrapRect.top;
      const stageBottomY = stageRect.bottom - wrapRect.top;

      // Keep tooltip within wrapper horizontally
      const clampedX = Math.max(160, Math.min(wrapRect.width - 160, stageCenterX));
      tooltip.style.left = `${clampedX}px`;

      // If close to top border, flip below the stage box
      if (stageTopY < 120) {
        tooltip.style.top = `${stageBottomY + 12}px`;
        tooltip.classList.add('is-flipped-below');
      } else {
        tooltip.style.top = `${stageTopY - 12}px`;
        tooltip.classList.remove('is-flipped-below');
      }

      tooltip.style.display = 'block';
      tooltip.classList.add('is-active');
      tooltip.setAttribute('aria-hidden', 'false');
    }

    function hideTooltip() {
      if (!tooltip) return;
      tooltip.classList.remove('is-active');
      tooltip.style.display = 'none';
      tooltip.setAttribute('aria-hidden', 'true');
    }

    stages.forEach((stage) => {
      stage.addEventListener('pointerenter', () => showTooltip(stage));
      stage.addEventListener('pointerleave', hideTooltip);
      stage.addEventListener('focusin', () => showTooltip(stage));
      stage.addEventListener('focusout', hideTooltip);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initMethodologyTooltips);
  } else {
    initMethodologyTooltips();
  }
  document.addEventListener('astro:page-load', initMethodologyTooltips);
</script>

<style>
  .methodology-figure-wrap {
    width: min(1320px, calc(100vw - 2rem));
    position: relative;
    left: 50%;
    transform: translateX(-50%);
    margin: 1.5rem 0 0.4rem;
    border: 1px solid var(--color-border);
    border-radius: 10px;
    padding: 0.75rem;
    background: #ffffff;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
    overflow: visible;
  }
  .methodology-svg {
    width: 100%;
    height: auto;
    display: block;
    overflow: visible;
  }

  .arrows { pointer-events: none; }

  .bold-underlined {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    font-weight: 700;
    text-decoration: underline;
    fill: #000000;
  }
  .title-lg { font-size: 20px; }
  .title-md { font-size: 19px; }
  .title-sm { font-size: 18px; }
