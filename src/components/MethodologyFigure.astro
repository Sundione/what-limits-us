---
// Full SVG recreation of sources/visualizations/hybrid/Iterative_Hybrid_Coding_2.png
// (= Figure 1 in the paper). Colors were sampled directly from the source
// PNG's own histogram (not guessed). Rebuilt as real shapes (not a raster
// image + overlay) so hovering a stage highlights the actual component -
// its own border glows - rather than a generic rectangle floating on top.
import PersonIcon from "./PersonIcon.astro";

interface Component {
  id: string;
  label: string;
  detail: string;
}

const components: Component[] = [
  { id: "limitations", label: "Limitations Section", detail: "Input: the raw text of a paper's Limitations section, e.g. “This study is limited by …”" },
  { id: "segmentation", label: "Semantic Unit Segmentation", detail: "Gemini 2.5 Flash splits the section into individual sentences (s₁, s₂, …), each coded independently next." },
  { id: "deductive", label: "Deductive coding", detail: "Gemini 3.1 Pro assigns existing codes from the current codebook Cₜ₋₁ (e.g. s₁ → Code 1, s₂ → Code 3)." },
  { id: "inductive", label: "Inductive coding", detail: "Where no existing code fits, the model proposes a new one (e.g. s₁ → “Poor data”) instead of forcing a bad match." },
  { id: "handling", label: "Handling New Codes", detail: "Inductively-proposed codes are clustered, a definition is recommended, a researcher reviews it, then applies it to the codebook — the only step with a human in the loop." },
  { id: "annotated", label: "Annotated Data", detail: "Output: each sentence's final code list, e.g. s₁ → [Code 1, Code 4], s₂ → [Code 3]." },
  { id: "updated-codebook", label: "Updated Codebook", detail: "The codebook after this paper's new code (Code 4) is applied — this becomes Cₜ₋₁ for the next paper/iteration." },
];
const byId = Object.fromEntries(components.map((c) => [c.id, c])) as Record<string, Component>;

const C = {
  outerPanel: "#cccccc",
  innerPanel: "#e6e6e6",
  tab: "#666666",
  seg: "#ecf3fe",
  segInner: "#7db0ff",
  hybrid: "#d8e8d4",
  hybridInner: "#a0cf76",
  handling: "#fbeedc",
  annotated: "#efd3d2",
  highlightBg: "#f9cee7",
  highlightText: "#c2255c",
  person: "#f1912a",
  border: "#999999",
  tableBorder: "#666666",
  text: "#1a1a1a",
};

function codebookRows(count: number) {
  return Array.from({ length: count }, (_, i) => ({ code: `Code ${i + 1}`, defn: `Defn. ${i + 1}` }));
}
---
<div class="methodology-figure-wrap">
  <svg viewBox="0 0 1691 672" role="img" aria-labelledby="methodology-svg-title" class="methodology-svg">
    <title id="methodology-svg-title">Iterative Hybrid Coding pipeline diagram</title>
    <defs>
      <marker id="arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M0,0 L10,5 L0,10 z" fill="#333" />
      </marker>
    </defs>

    <rect x="6" y="6" width="1679" height="660" rx="14" fill={C.outerPanel} />
    <rect x="22" y="20" width="150" height="40" rx="8" fill={C.tab} />
    <text x="97" y="45" text-anchor="middle" class="tab-label">Iteration <tspan font-style="italic">t</tspan></text>

    <rect x="266" y="60" width="1022" height="580" rx="14" fill={C.innerPanel} />
    <rect x="284" y="76" width="128" height="38" rx="8" fill={C.tab} />
    <text x="348" y="100" text-anchor="middle" class="tab-label">Paper <tspan font-style="italic">i</tspan></text>

    <text x="16" y="398" class="table-label">Initial Codebook: <tspan font-style="italic">C</tspan><tspan font-style="italic" font-size="11" dy="3">o</tspan></text>
    <g transform="translate(16, 412)">
      {codebookRows(3).map((row, i) => (
        <g transform={`translate(0, ${i * 28})`}>
          <rect x="0" y="0" width="90" height="28" fill="#fff" stroke={C.tableBorder} />
          <rect x="90" y="0" width="90" height="28" fill="#fff" stroke={C.tableBorder} />
          <text x="45" y="19" text-anchor="middle" class="table-cell">{row.code}</text>
          <text x="135" y="19" text-anchor="middle" class="table-cell">{row.defn}</text>
        </g>
      ))}
    </g>
    <g transform="translate(178, 486)"><PersonIcon color={C.person} /></g>

    <text x="300" y="398" class="table-label">Codebook: <tspan font-style="italic">C</tspan><tspan font-style="italic" font-size="11" dy="3">t-1</tspan></text>
    <g transform="translate(300, 412)">
      {codebookRows(3).map((row, i) => (
        <g transform={`translate(0, ${i * 28})`}>
          <rect x="0" y="0" width="90" height="28" fill="#fff" stroke={C.tableBorder} />
          <rect x="90" y="0" width="90" height="28" fill="#fff" stroke={C.tableBorder} />
          <text x="45" y="19" text-anchor="middle" class="table-cell">{row.code}</text>
          <text x="135" y="19" text-anchor="middle" class="table-cell">{row.defn}</text>
        </g>
      ))}
    </g>

    <g>
      <rect class="zone-hit" tabindex="0" role="button" aria-label={`${byId.limitations.label}: ${byId.limitations.detail}`} x="312" y="146" width="192" height="228" fill="transparent" />
      <rect class="zone-visual" x="316" y="150" width="185" height="220" rx="8" fill="#ffffff" stroke={C.border} stroke-width="1.5" />
      <text x="408" y="182" text-anchor="middle" class="box-title">Limitations</text>
      <text x="408" y="202" text-anchor="middle" class="box-title">Section</text>
      <text x="330" y="250" class="quote-text"><tspan x="330" dy="0">"This study is</tspan><tspan x="330" dy="18">limited by…"</tspan></text>
      <foreignObject class="tooltip-fo" x="316" y="0" width="230" height="140"><div xmlns="http://www.w3.org/1999/xhtml" class="tooltip"><strong>{byId.limitations.label}</strong><span>{byId.limitations.detail}</span></div></foreignObject>
    </g>

    <g>
      <rect class="zone-hit" tabindex="0" role="button" aria-label={`${byId.segmentation.label}: ${byId.segmentation.detail}`} x="549" y="104" width="188" height="278" fill="transparent" />
      <rect class="zone-visual" x="553" y="108" width="180" height="270" rx="14" fill={C.seg} />
      <text x="643" y="138" text-anchor="middle" class="box-title">Semantic Unit</text>
      <text x="643" y="158" text-anchor="middle" class="box-title">Segmentation</text>
      <rect x="568" y="176" width="150" height="76" rx="8" fill={C.segInner} />
      <text x="578" y="205" class="s-text"><tspan x="578" dy="0">s₁ = "This study</tspan><tspan x="578" dy="17">is limited by …"</tspan></text>
      <rect x="568" y="264" width="150" height="76" rx="8" fill={C.segInner} />
      <text x="578" y="293" class="s-text"><tspan x="578" dy="0">s₂ = "Moreover,</tspan><tspan x="578" dy="17">our model is …"</tspan></text>
      <foreignObject class="tooltip-fo" x="553" y="0" width="230" height="100"><div xmlns="http://www.w3.org/1999/xhtml" class="tooltip"><strong>{byId.segmentation.label}</strong><span>{byId.segmentation.detail}</span></div></foreignObject>
    </g>

    <rect x="778" y="108" width="412" height="452" rx="14" fill={C.hybrid} />
    <text x="800" y="316" class="box-title hybrid-label"><tspan x="800" dy="0">Automatic</tspan><tspan x="800" dy="20">Hybrid</tspan><tspan x="800" dy="20">Coding</tspan></text>

    <g>
      <rect class="zone-hit" tabindex="0" role="button" aria-label={`${byId.deductive.label}: ${byId.deductive.detail}`} x="916" y="128" width="230" height="204" fill="transparent" />
      <rect class="zone-visual" x="920" y="132" width="222" height="196" rx="10" fill={C.hybridInner} />
      <text x="1031" y="164" text-anchor="middle" class="box-title-sm">Deductive</text>
      <text x="936" y="190" class="body-text"><tspan x="936" dy="0">Assign existing</tspan><tspan x="936" dy="16">codes</tspan></text>
      <text x="936" y="240" class="body-text"><tspan x="936" dy="0">s₁ → Code 1</tspan><tspan x="936" dy="18">s₂ → Code 3</tspan></text>
      <foreignObject class="tooltip-fo" x="920" y="0" width="230" height="110"><div xmlns="http://www.w3.org/1999/xhtml" class="tooltip"><strong>{byId.deductive.label}</strong><span>{byId.deductive.detail}</span></div></foreignObject>
    </g>

    <g>
      <rect class="zone-hit" tabindex="0" role="button" aria-label={`${byId.inductive.label}: ${byId.inductive.detail}`} x="916" y="346" width="230" height="198" fill="transparent" />
      <rect class="zone-visual" x="920" y="350" width="222" height="190" rx="10" fill={C.hybridInner} />
      <text x="1031" y="382" text-anchor="middle" class="box-title-sm">Inductive</text>
      <text x="936" y="408" class="body-text"><tspan x="936" dy="0">Assign new</tspan><tspan x="936" dy="16">codes</tspan></text>
      <text x="936" y="458" class="body-text">s₁ → Poor data</text>
      <foreignObject class="tooltip-fo" x="920" y="546" width="230" height="110"><div xmlns="http://www.w3.org/1999/xhtml" class="tooltip"><strong>{byId.inductive.label}</strong><span>{byId.inductive.detail}</span></div></foreignObject>
    </g>

    <g>
      <rect class="zone-hit" tabindex="0" role="button" aria-label={`${byId.handling.label}: ${byId.handling.detail}`} x="1168" y="104" width="176" height="460" fill="transparent" />
      <rect class="zone-visual" x="1172" y="108" width="168" height="452" rx="14" fill={C.handling} />
      <text x="1256" y="138" text-anchor="middle" class="box-title"><tspan x="1256" dy="0">Handling New</tspan><tspan x="1256" dy="20">Codes</tspan></text>
      <rect x="1185" y="178" width="142" height="300" rx="8" fill="#ffffff" stroke="#cccccc" />
      {["Cluster", "Recommend", "Human Review", "Apply"].map((row, i) => (
        <g>
          {i > 0 && <line x1="1185" x2="1327" y1={178 + i * 75} y2={178 + i * 75} stroke="#dddddd" />}
          <text x="1256" y={178 + i * 75 + 42} text-anchor="middle" class="body-text">{row}</text>
        </g>
      ))}
      <g transform="translate(1178, 440)"><PersonIcon color={C.person} /></g>
      <foreignObject class="tooltip-fo" x="1172" y="0" width="230" height="100"><div xmlns="http://www.w3.org/1999/xhtml" class="tooltip"><strong>{byId.handling.label}</strong><span>{byId.handling.detail}</span></div></foreignObject>
    </g>

    <g>
      <rect class="zone-hit" tabindex="0" role="button" aria-label={`${byId.annotated.label}: ${byId.annotated.detail}`} x="1400" y="56" width="278" height="236" fill="transparent" />
      <rect class="zone-visual" x="1404" y="60" width="270" height="228" rx="14" fill={C.annotated} />
      <text x="1539" y="92" text-anchor="middle" class="box-title">Annotated Data</text>
      <text x="1420" y="130" class="body-text">s₁ → [Code 1, <tspan font-weight="700">Code 4</tspan>]</text>
      <text x="1420" y="156" class="body-text">s₂ → [Code 3]</text>
      <foreignObject class="tooltip-fo" x="1400" y="0" width="230" height="90"><div xmlns="http://www.w3.org/1999/xhtml" class="tooltip"><strong>{byId.annotated.label}</strong><span>{byId.annotated.detail}</span></div></foreignObject>
    </g>

    <g>
      <rect class="zone-hit" tabindex="0" role="button" aria-label={`${byId["updated-codebook"].label}: ${byId["updated-codebook"].detail}`} x="1396" y="392" width="238" height="160" fill="transparent" />
      <rect class="zone-visual" x="1400" y="416" width="208" height="128" rx="6" fill="none" />
      <text x="1404" y="410" class="table-label">Updated Codebook: <tspan font-style="italic">C</tspan><tspan font-style="italic" font-size="11" dy="3">t</tspan></text>
      <g transform="translate(1404, 420)">
        {codebookRows(4).map((row, i) => {
          const isNew = i === 3;
          return (
            <g transform={`translate(0, ${i * 30})`}>
              <rect x="0" y="0" width="100" height="30" fill={isNew ? C.highlightBg : "#fff"} stroke={C.tableBorder} />
              <rect x="100" y="0" width="100" height="30" fill={isNew ? C.highlightBg : "#fff"} stroke={C.tableBorder} />
              <text x="50" y="20" text-anchor="middle" class="table-cell" fill={isNew ? C.highlightText : C.text}>{row.code}</text>
              <text x="150" y="20" text-anchor="middle" class="table-cell" fill={isNew ? C.highlightText : C.text}>{row.defn}</text>
            </g>
          );
        })}
      </g>
      <foreignObject class="tooltip-fo" x="1404" y="0" width="230" height="100"><div xmlns="http://www.w3.org/1999/xhtml" class="tooltip"><strong>{byId["updated-codebook"].label}</strong><span>{byId["updated-codebook"].detail}</span></div></foreignObject>
    </g>

    <rect x="700" y="596" width="430" height="42" rx="21" fill="none" stroke="#444" stroke-dasharray="5 3" />
    <text x="915" y="622" text-anchor="middle" class="loop-text">Used in the next iteration</text>

    <!-- Arrows drawn last so they paint on top of every box fill -->
    <g class="arrows">
      <polyline points="196,468 300,468" marker-end="url(#arrow)" />
      <polyline points="480,468 778,468" marker-end="url(#arrow)" />
      <polyline points="504,260 549,260" marker-end="url(#arrow)" />
      <polyline points="737,243 760,243 760,230 916,230" marker-end="url(#arrow)" />
      <polyline points="737,243 760,243 760,445 916,445" marker-end="url(#arrow)" />
      <polyline points="1146,180 1146,95 1400,95 1400,150" marker-end="url(#arrow)" />
      <polyline points="1146,445 1168,445" marker-end="url(#arrow)" />
      <polyline points="1256,104 1256,85 1539,85 1539,292" marker-end="url(#arrow)" />
      <polyline points="1344,455 1396,472" marker-end="url(#arrow)" />
      <polyline points="1519,552 1519,592 1130,592" marker-end="url(#arrow)" />
      <polyline points="700,592 390,592 390,508" marker-end="url(#arrow)" />
    </g>
  </svg>
</div>
<p class="methodology-hint">Hover or tap a stage of the diagram for details.</p>

<style>
  .methodology-figure-wrap {
    width: 100%;
    margin: 1.25rem 0 0.25rem;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 0.5rem;
    background: #fff;
  }
  .methodology-svg { width: 100%; height: auto; display: block; overflow: visible; }

  .arrows { pointer-events: none; }
  .arrows polyline { fill: none; stroke: #333; stroke-width: 2.5; }

  .tab-label { fill: #ffffff; font-size: 19px; font-weight: 700; }
  .table-label { fill: #1a1a1a; font-size: 15px; font-weight: 700; text-decoration: underline; }
  .table-cell { fill: #1a1a1a; font-size: 13px; }
  .box-title { fill: #1a1a1a; font-size: 17px; font-weight: 700; text-decoration: underline; }
  .box-title-sm { fill: #1a1a1a; font-size: 15px; font-weight: 700; text-decoration: underline; }
  .hybrid-label { text-anchor: start; }
  .body-text { fill: #1a1a1a; font-size: 13.5px; }
  .quote-text { fill: #1a1a1a; font-size: 14px; font-style: italic; }
  .s-text { fill: #ffffff; font-size: 13px; }
  .loop-text { fill: #333; font-size: 15px; }

  /* Only the hit-rect should ever capture pointer events - every decorative
     shape drawn on top of it (the Handling-New-Codes inner list box, table
     cells, text, arrows, tooltips) must pass events through, or hovering
     the visible content of a stage silently does nothing. */
  .methodology-svg rect:not(.zone-hit),
  .methodology-svg text,
  .methodology-svg line,
  .methodology-svg .tooltip-fo {
    pointer-events: none;
  }
  .zone-hit { cursor: pointer; outline: none; pointer-events: all; }
  .zone-visual { transition: filter 0.12s ease; }
  .zone-hit:hover ~ .zone-visual,
  .zone-hit:focus-visible ~ .zone-visual {
    outline: 3px solid var(--color-accent);
    outline-offset: -1.5px;
  }

  .tooltip-fo { overflow: visible; pointer-events: none; }
  .tooltip {
    display: flex;
    flex-direction: column;
    gap: 3px;
    background: #1a1a1a;
    color: #fff;
    font-size: 12.5px;
    line-height: 1.35;
    padding: 8px 10px;
    border-radius: 6px;
    opacity: 0;
    transition: opacity 0.12s ease;
    font-family: system-ui, sans-serif;
  }
  .zone-hit:hover ~ .tooltip-fo .tooltip,
  .zone-hit:focus-visible ~ .tooltip-fo .tooltip {
    opacity: 1;
  }

  .methodology-hint { font-size: 0.78rem; color: var(--color-muted); margin-top: 0.4rem; }
</style>
