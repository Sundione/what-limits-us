---
// Brand mark: lines of text running into a boundary (a "limit"). Colours come
// from theme tokens so the mark follows light/dark mode; public/favicon.svg is
// the same drawing with fixed colours.
interface Props {
  size?: number;
  class?: string;
}
const { size = 28, class: className = "" } = Astro.props;
---
<svg class={`logo-mark ${className}`} width={size} height={size} viewBox="0 0 32 32" aria-hidden="true">
  <rect class="logo-mark-bg" width="32" height="32" rx="8" />
  <rect class="logo-mark-fg" x="7" y="9" width="14" height="2.6" rx="1.3" />
  <rect class="logo-mark-fg" x="7" y="14.7" width="11" height="2.6" rx="1.3" />
  <rect class="logo-mark-fg" x="7" y="20.4" width="7" height="2.6" rx="1.3" />
  <rect class="logo-mark-fg" x="23.2" y="7" width="2.6" height="18" rx="1.3" />
</svg>

<style>
  .logo-mark {
    flex-shrink: 0;
    display: block;
  }
  .logo-mark-bg {
    fill: var(--primary);
  }
  .logo-mark-fg {
    fill: var(--on-color);
  }
</style>
