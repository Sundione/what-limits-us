---
import { Check, CircleAlert, Search, Sparkles } from "lucide-preact";
// Ultra-simple, high-impact landing page showcase for Deductive vs. Inductive Coding.
// Shows in 10 seconds how the pipeline assigns existing codes vs. discovers new ones with human review.
import PersonIcon from "./PersonIcon.astro";
---

<div class="simple-showcase-wrap">
  <div class="showcase-header">
    <span class="showcase-badge">HOW IT WORKS IN PRACTICE</span>
    <h3 class="showcase-title">Deductive vs. Inductive Coding</h3>
    <p class="showcase-subtitle">
      How the model handles a familiar limitation vs. a genuinely new one when analyzing a paper:
    </p>
  </div>

  <div class="showcase-grid">
    <!-- Card 1: Deductive (Existing Code) -->
    <div class="showcase-card deductive-card">
      <div class="card-top">
        <span class="type-pill deductive">CASE 1: DEDUCTIVE</span>
        <span class="status-pill matched"><Check size={13} aria-hidden="true" /> Matches Codebook</span>
      </div>

      <div class="sentence-box">
        <span class="box-label">Sentence from Paper:</span>
        <p class="quote">“MAVEN-ARG currently includes only English corpus, which limits its potential applications and coverage for diverse linguistic phenomena.”</p>
        <a class="quote-source" href={`${import.meta.env.BASE_URL}explore?paper=2024.acl-long.224`}>MAVEN-ARG · ACL 2024 &rarr;</a>
      </div>

      <div class="flow-steps">
        <div class="flow-step">
          <span class="step-icon search"><Search size={13} aria-hidden="true" /></span>
          <div class="step-text">
            <strong>Check Codebook (Cₜ₋₁):</strong>
            <span>Model finds an exact conceptual fit in existing definitions.</span>
          </div>
        </div>

        <div class="flow-arrow">&darr;</div>

        <div class="flow-step highlight-step deductive-hl">
          <span class="step-icon check"><Check size={13} aria-hidden="true" /></span>
          <div class="step-text">
            <strong>Assign Code:</strong>
            <span class="code-tag blue">Scope Limitation</span>
            <span class="theme-tag-small">Theme 2: Constraints &amp; Scope</span>
          </div>
        </div>
      </div>

      <div class="card-outcome pass-outcome">
        <Check size={14} aria-hidden="true" class="outcome-icon" /> <strong>Outcome:</strong> Coded immediately. No codebook change needed.
      </div>
    </div>

    <!-- Card 2: Inductive (New Code + Human in the loop) -->
    <div class="showcase-card inductive-card">
      <div class="card-top">
        <span class="type-pill inductive">CASE 2: INDUCTIVE</span>
        <span class="status-pill new-needed">&plus; New Code Proposed</span>
      </div>

      <div class="sentence-box">
        <span class="box-label">Sentence from Paper:</span>
        <p class="quote">“However, it is possible that some other relevant works were overlooked, potentially leading to inaccuracies in our analysis.”</p>
        <a class="quote-source" href={`${import.meta.env.BASE_URL}explore?paper=2024.acl-long.599`}>LLM capabilities survey · ACL 2024 &rarr;</a>
      </div>

      <div class="flow-steps">
        <div class="flow-step">
          <span class="step-icon warning"><CircleAlert size={13} aria-hidden="true" /></span>
          <div class="step-text">
            <strong>Check Codebook (Cₜ₋₁):</strong>
            <span>No existing code captures a gap in literature coverage.</span>
          </div>
        </div>

        <div class="flow-arrow">&darr;</div>

        <div class="flow-step">
          <span class="step-icon spark"><Sparkles size={13} aria-hidden="true" /></span>
          <div class="step-text">
            <strong>Model Proposes New Code:</strong>
            <em>“Literature Coverage Gap”</em>
          </div>
        </div>

        <div class="flow-arrow">&darr;</div>

        <div class="flow-step highlight-step human-hl">
          <span class="step-icon human">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="vertical-align: -2px;">
              <circle cx="12" cy="7" r="4"></circle>
              <path d="M5.5 21a8.38 8.38 0 0 1 13 0"></path>
            </svg>
          </span>
          <div class="step-text">
            <strong>Human Researcher Reviews &amp; Approves:</strong>
            <span class="code-tag emerald">&plus; Literature Coverage Gap</span>
          </div>
        </div>
      </div>

      <div class="card-outcome new-outcome">
        <Sparkles size={14} aria-hidden="true" class="outcome-icon" /> <strong>Outcome:</strong> Codebook expands (C₂ &rarr; C₃) and the new code is used for the 2025 papers.
      </div>
    </div>
  </div>

  <div class="showcase-footer">
    <span class="loopback-note">
      <strong>Iterative Growth:</strong> Over 4 conference iterations (2020–2025), this exact loop expanded our codebook from <strong>25 initial seed codes to 50 comprehensive codes</strong>.
    </span>
    <div class="footer-links">
      <a href={`${import.meta.env.BASE_URL}codebook`} class="subtle-link">Browse all 50 codes &rarr;</a>
      <a href={`${import.meta.env.BASE_URL}explore`} class="primary-link">Explore the dataset &rarr;</a>
    </div>
  </div>
</div>

<style>
  .simple-showcase-wrap {
    margin: 2rem 0 2.25rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--card);
    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.05);
    overflow: hidden;
  }

  .showcase-header {
    padding: 1.35rem 1.5rem 1rem;
    background: var(--card);
    border-bottom: 1px solid var(--color-border);
  }

  .showcase-badge {
    display: inline-block;
    padding: 0.18rem 0.55rem;
    background: var(--primary-soft);
    color: var(--primary-text);
    border: 1px solid var(--primary-border);
    border-radius: var(--radius-sm);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    margin-bottom: 0.45rem;
  }

  .showcase-title {
    margin: 0 0 0.35rem;
    font-size: 1.25rem;
    color: var(--foreground);
    font-weight: 700;
  }

  .showcase-subtitle {
    margin: 0;
    font-size: 0.92rem;
    color: var(--color-muted);
    line-height: 1.45;
  }

  /* Side-by-side grid */
  .showcase-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
    padding: 1.25rem 1.5rem;
  }

  @media (max-width: 840px) {
    .showcase-grid {
      grid-template-columns: 1fr;
    }
  }

  .showcase-card {
    border: 1.5px solid var(--border);
    border-radius: var(--radius);
    padding: 1.15rem;
    background: var(--card);
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .showcase-card:hover {
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.06);
    transform: translateY(-2px);
  }

  .deductive-card {
    border-color: var(--primary-border);
  }

  .inductive-card {
    border-color: var(--orange-border);
  }

  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border);
  }

  .type-pill {
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-sm);
  }

  .type-pill.deductive {
    background: var(--primary-soft-2);
    color: var(--primary-strong);
  }

  .type-pill.inductive {
    background: var(--orange-bg);
    color: var(--orange-fg);
  }

  .status-pill {
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.15rem 0.5rem;
    border-radius: 999px;
  }

  .status-pill.matched {
    background: var(--green-bg);
    color: var(--green-fg);
    border: 1px solid var(--green-border);
  }

  .status-pill.new-needed {
    background: var(--amber-bg);
    color: var(--amber-fg);
    border: 1px solid var(--amber-border);
  }

  .sentence-box {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 0.65rem 0.85rem;
  }

  .box-label {
    display: block;
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--muted-foreground);
    margin-bottom: 0.2rem;
  }

  .quote {
    margin: 0;
    font-size: 0.88rem;
    line-height: 1.45;
    color: var(--foreground);
    font-style: italic;
  }

  .quote-source {
    display: inline-block;
    margin-top: 0.4rem;
    font-size: 0.76rem;
    font-weight: 600;
    color: var(--primary-text);
    text-decoration: none;
  }
  .quote-source:hover {
    text-decoration: underline;
  }

  .flow-steps {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    flex: 1;
  }

  .flow-step {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    padding: 0.5rem 0.7rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    font-size: 0.82rem;
    line-height: 1.4;
  }

  .step-icon {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.75rem;
    font-weight: 800;
    flex-shrink: 0;
    background: var(--track);
    color: var(--muted-foreground);
  }

  .step-icon.check { background: var(--primary-soft-2); color: var(--primary-strong); }
  .step-icon.warning { background: var(--rose-bg); color: var(--rose-fg); }
  .step-icon.spark { background: var(--orange-bg); color: var(--orange-fg); }
  .step-icon.human { background: var(--amber-solid); color: var(--on-color); }

  .step-text {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    color: var(--foreground-soft);
  }

  .step-text strong {
    color: var(--foreground);
    font-size: 0.83rem;
  }

  .flow-arrow {
    text-align: center;
    color: var(--muted-foreground-faint);
    font-size: 0.85rem;
    line-height: 0.8;
  }

  .highlight-step.deductive-hl {
    background: var(--primary-soft);
    border-color: var(--primary-border);
  }

  .highlight-step.human-hl {
    background: var(--amber-bg);
    border-color: var(--amber-border);
  }

  .code-tag {
    display: inline-block;
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-sm);
    font-weight: 700;
    font-size: 0.8rem;
    width: max-content;
  }

  .code-tag.blue { background: var(--primary-soft-2); color: var(--primary-strong); }
  .code-tag.emerald { background: var(--green-bg); color: var(--green-fg); }

  .theme-tag-small {
    font-size: 0.74rem;
    color: var(--muted-foreground);
  }

  .card-outcome {
    padding: 0.55rem 0.8rem;
    border-radius: var(--radius-sm);
    font-size: 0.82rem;
    line-height: 1.4;
  }

  .pass-outcome {
    background: var(--green-bg);
    color: var(--green-fg);
    border: 1px solid var(--green-border);
  }

  .new-outcome {
    background: var(--orange-bg);
    color: var(--orange-fg);
    border: 1px solid var(--orange-border);
  }

  /* Footer */
  .showcase-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1.5rem;
    background: var(--surface);
    border-top: 1px solid var(--color-border);
  }

  .loopback-note {
    font-size: 0.84rem;
    color: var(--muted-foreground);
    max-width: 600px;
    line-height: 1.45;
  }

  .footer-links {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .subtle-link {
    font-size: 0.84rem;
    color: var(--muted-foreground);
    text-decoration: none;
    font-weight: 600;
  }

  .subtle-link:hover {
    color: var(--foreground);
    text-decoration: underline;
  }

  .primary-link {
    font-size: 0.84rem;
    font-weight: 600;
    padding: 0.4rem 0.85rem;
    background: var(--primary);
    color: var(--on-color);
    border-radius: var(--radius-sm);
    text-decoration: none;
    transition: background 0.15s ease;
  }

  .primary-link:hover {
    background: var(--primary-hover);
    color: var(--on-color);
  }
</style>
