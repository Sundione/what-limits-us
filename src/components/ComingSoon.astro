---
interface Props {
  title: string;
  blurb: string;
}
const { title, blurb } = Astro.props;
---
<h1>{title}</h1>
<p class="coming-soon-blurb">{blurb}</p>
<p class="coming-soon-note">
  This page isn't built yet. In the meantime, you can{" "}
  <a href={`${import.meta.env.BASE_URL}explore`}>explore the dataset directly</a>,
  or follow progress on{" "}
  <a href="https://github.com/Sundione/what-limits-us">GitHub</a>.
</p>

<style>
  .coming-soon-blurb { font-size: 1.05rem; }
  .coming-soon-note {
    color: var(--color-muted);
    border: 1px dashed var(--color-border);
    border-radius: 8px;
    padding: 1rem 1.25rem;
    margin-top: 1.5rem;
  }
</style>
