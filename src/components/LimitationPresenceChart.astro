---
// Reproduces the paper's Figure 2 design (colors sampled directly from the
// paper PDF): stacked bars for raw paper counts (dark = has an explicit
// Limitations section, light = doesn't) on the left axis, plus a % adoption
// line per venue on the right axis. Bars link to the explorer, pre-filtered
// to that year+venue, per user request.
import { presenceRows, adoptionPct, type PresenceRow } from "../data/limitationPresence";

const years = [2020, 2021, 2022, 2023, 2024, 2025];
const rowFor = (venue: PresenceRow["venue"], year: number) =>
  presenceRows.find((r) => r.venue === venue && r.year === year)!;

const COLORS = {
  aclDark: "#0072b2",
  aclLight: "#b6dbff",
  emnlpDark: "#e69f00",
  emnlpLight: "#ffe2b3",
};

const width = 720;
const height = 400;
const padL = 46;
const padR = 46;
const padT = 16;
const padB = 78; // room for x labels + legend
const plotW = width - padL - padR;
const plotH = height - padT - padB;

const countMax = 3500; // matches the paper's own left-axis scale
const pctMax = 100;

const groupW = plotW / years.length;
const barW = groupW * 0.32;
const barGap = groupW * 0.06;

const yForCount = (n: number) => padT + (1 - n / countMax) * plotH;
const yForPct = (p: number) => padT + (1 - p / pctMax) * plotH;
const xForGroupCenter = (i: number) => padL + groupW * i + groupW / 2;

interface Bar {
  x: number;
  yTop: number;
  hasH: number;
  noH: number;
  row: PresenceRow;
  darkColor: string;
  lightColor: string;
}

const aclBars: Bar[] = years.map((year, i) => {
  const row = rowFor("ACL", year);
  const cx = xForGroupCenter(i);
  const x = cx - barGap / 2 - barW;
  const hasTop = yForCount(row.papersWithLimitations);
  const noTop = yForCount(row.totalPapers);
  return { x, yTop: hasTop, hasH: yForCount(0) - hasTop, noH: hasTop - noTop, row, darkColor: COLORS.aclDark, lightColor: COLORS.aclLight };
});
const emnlpBars: Bar[] = years.map((year, i) => {
  const row = rowFor("EMNLP", year);
  const cx = xForGroupCenter(i);
  const x = cx + barGap / 2;
  const hasTop = yForCount(row.papersWithLimitations);
  const noTop = yForCount(row.totalPapers);
  return { x, yTop: hasTop, hasH: yForCount(0) - hasTop, noH: hasTop - noTop, row, darkColor: COLORS.emnlpDark, lightColor: COLORS.emnlpLight };
});

const aclLinePoints = years.map((year, i) => ({ x: xForGroupCenter(i), y: yForPct(adoptionPct(rowFor("ACL", year))), row: rowFor("ACL", year) }));
const emnlpLinePoints = years.map((year, i) => ({ x: xForGroupCenter(i), y: yForPct(adoptionPct(rowFor("EMNLP", year))), row: rowFor("EMNLP", year) }));
const aclLine = aclLinePoints.map((p) => `${p.x},${p.y}`).join(" ");
const emnlpLine = emnlpLinePoints.map((p) => `${p.x},${p.y}`).join(" ");

// Pre-mandate years are the ones worth a direct % label (post-mandate values
// cluster near 100% and are already obvious from the line's position).
const labelYears = new Set([2020, 2021]);
const aclLabelPoints = aclLinePoints.filter((p) => labelYears.has(p.row.year) || (p.row.venue === "ACL" && p.row.year === 2022));
const emnlpLabelPoints = emnlpLinePoints.filter((p) => labelYears.has(p.row.year));

const countGrid = [0, 500, 1000, 1500, 2000, 2500, 3000, 3500];
const pctGrid = [0, 20, 40, 60, 80, 100];

function exploreUrl(year: number, venue: string) {
  return `${import.meta.env.BASE_URL}explore?year=${year}&venue=${venue}`;
}
---
<div class="presence-chart">
  <svg
    viewBox={`0 0 ${width} ${height}`}
    role="img"
    aria-label="Number and percentage of ACL and EMNLP papers with an explicit Limitations section, 2020 to 2025, styled after the paper's own Figure 2. Both venues rise from single digits to effectively 100% following the EMNLP 2022 / ACL 2023 mandatory-reporting policy. Click a bar to see that year's papers."
  >
    {countGrid.map((n) => (
      <g>
        <line x1={padL} x2={width - padR} y1={yForCount(n)} y2={yForCount(n)} class="gridline" />
        <text x={padL - 6} y={yForCount(n)} class="axis-label" text-anchor="end" dominant-baseline="middle">{n}</text>
      </g>
    ))}
    {pctGrid.map((p) => (
      <text x={width - padR + 6} y={yForPct(p)} class="axis-label" text-anchor="start" dominant-baseline="middle">{p}%</text>
    ))}
    <text x={14} y={padT + plotH / 2} class="axis-title" transform={`rotate(-90 14 ${padT + plotH / 2})`} text-anchor="middle">Number of papers</text>

    {years.map((y, i) => (
      <text x={xForGroupCenter(i)} y={height - padB + 18} class="axis-label" text-anchor="middle">{y}</text>
    ))}

    {[...aclBars, ...emnlpBars].map((bar) => (
      <a href={exploreUrl(bar.row.year, bar.row.venue.toLowerCase())} class="bar-link">
        <title>{`${bar.row.venue} ${bar.row.year}: ${bar.row.papersWithLimitations.toLocaleString()} of ${bar.row.totalPapers.toLocaleString()} papers have an explicit Limitations section (${adoptionPct(bar.row).toFixed(1)}% adopted). Click to see these papers.`}</title>
        <rect x={bar.x} y={bar.yTop} width={barW} height={bar.hasH} fill={bar.darkColor} class="bar-seg" />
        <rect x={bar.x} y={bar.yTop - bar.noH} width={barW} height={bar.noH} fill={bar.lightColor} class="bar-seg" />
      </a>
    ))}

    <polyline points={aclLine} class="line-acl" fill="none" />
    <polyline points={emnlpLine} class="line-emnlp" fill="none" />
    {aclLinePoints.map((p) => <circle cx={p.x} cy={p.y} r="3" class="point-acl" />)}
    {emnlpLinePoints.map((p) => <circle cx={p.x} cy={p.y} r="3" class="point-emnlp" />)}

    {aclLabelPoints.map((p) => (
      <g transform={`translate(${p.x - 24}, ${p.y - 16})`}>
        <rect x="-19" y="-11" width="38" height="18" rx="4" class="pct-label-box pct-label-acl" />
        <text y="2.5" text-anchor="middle" class="pct-label-text pct-label-text-acl">{adoptionPct(p.row).toFixed(1)}%</text>
      </g>
    ))}
    {emnlpLabelPoints.map((p) => (
      <g transform={`translate(${p.x + 24}, ${p.y - 16})`}>
        <rect x="-19" y="-11" width="38" height="18" rx="4" class="pct-label-box pct-label-emnlp" />
        <text y="2.5" text-anchor="middle" class="pct-label-text pct-label-text-emnlp">{adoptionPct(p.row).toFixed(1)}%</text>
      </g>
    ))}
  </svg>

  <div class="presence-legend">
    <span class="legend-item"><span class="swatch" style={`background:${COLORS.aclDark}`}></span>ACL — Has Limitations Section</span>
    <span class="legend-item"><span class="swatch" style={`background:${COLORS.emnlpDark}`}></span>EMNLP — Has Limitations Section</span>
    <span class="legend-item"><span class="swatch" style={`background:${COLORS.aclLight}`}></span>ACL — No Limitations Section</span>
    <span class="legend-item"><span class="swatch" style={`background:${COLORS.emnlpLight}`}></span>EMNLP — No Limitations Section</span>
    <span class="legend-item"><span class="swatch swatch-line" style={`background:${COLORS.aclDark}`}></span>ACL — % Adoption</span>
    <span class="legend-item"><span class="swatch swatch-line" style={`background:${COLORS.emnlpDark}`}></span>EMNLP — % Adoption</span>
  </div>

  <p class="presence-caption">
    Click a bar to see that year's papers. From EMNLP 2022 onward, the %
    adoption line doesn't count pipeline extraction failures against
    adoption — a failed extraction is inconclusive, not evidence the section
    is missing; only papers confirmed to have no explicit section count as
    non-adopters. (Bar segments use raw has/doesn't-have counts.)
  </p>

  <details class="presence-table-details">
    <summary>View exact counts</summary>
    <table class="presence-table">
      <thead>
        <tr>
          <th>Venue</th><th>Year</th><th>Total papers</th><th>Has Limitations</th>
          <th>Pipeline failure</th><th>Truly missing</th><th>Adoption %</th>
        </tr>
      </thead>
      <tbody>
        {presenceRows.map((row) => (
          <tr>
            <td>{row.venue}</td>
            <td>{row.year}</td>
            <td>{row.totalPapers.toLocaleString()}</td>
            <td>{row.papersWithLimitations.toLocaleString()}</td>
            <td>{row.extractionFailures === null ? "—" : row.extractionFailures.toLocaleString()}</td>
            <td>{row.noExplicitLimitations === null ? "—" : row.noExplicitLimitations.toLocaleString()}</td>
            <td>{adoptionPct(row).toFixed(1)}%</td>
          </tr>
        ))}
      </tbody>
    </table>
    <p class="presence-table-note">
      "Pipeline failure" = the extraction pipeline couldn't process the paper
      (inconclusive - the paper may or may not actually have a Limitations
      section). "Truly missing" = manually verified to genuinely lack one.
      Only available from EMNLP 2022 onward, when this breakdown was tracked
      ("—" = not tracked for that year). From the paper's own reported
      figures (Section 4.1 / Table 3).
    </p>
  </details>
</div>

<style>
  .presence-chart { margin: 1rem 0; }
  svg { width: 100%; height: auto; max-width: 720px; display: block; }

  .gridline { stroke: var(--color-border); stroke-width: 1; }
  .axis-label { fill: var(--color-muted); font-size: 10px; }
  .axis-title { fill: var(--color-muted); font-size: 10px; }

  .bar-link { cursor: pointer; }
  .bar-seg { transition: opacity 0.1s ease; }
  .bar-link:hover .bar-seg,
  .bar-link:focus-visible .bar-seg { opacity: 0.75; }
  .bar-link:focus-visible { outline: 2px solid var(--color-text); }

  .line-acl { stroke: #0072b2; stroke-width: 2; }
  .line-emnlp { stroke: #e69f00; stroke-width: 2; }
  .point-acl { fill: #0072b2; }
  .point-emnlp { fill: #e69f00; }

  .pct-label-box { fill: var(--color-bg); stroke-width: 1.5; }
  .pct-label-acl { stroke: #0072b2; }
  .pct-label-emnlp { stroke: #e69f00; }
  .pct-label-text { font-size: 10px; font-weight: 700; }
  .pct-label-text-acl { fill: #0072b2; }
  .pct-label-text-emnlp { fill: #e69f00; }

  .presence-legend {
    display: flex;
    flex-wrap: wrap;
    column-gap: 1.25rem;
    row-gap: 0.35rem;
    font-size: 0.78rem;
    color: var(--color-muted);
    margin-top: 0.5rem;
  }
  .legend-item { display: inline-flex; align-items: center; gap: 0.4rem; }
  .swatch { display: inline-block; width: 0.7rem; height: 0.7rem; border-radius: 2px; }
  .swatch-line { width: 1.1rem; height: 0.2rem; border-radius: 1px; }

  .presence-caption { font-size: 0.8rem; color: var(--color-muted); margin-top: 0.6rem; }

  .presence-table-details { margin-top: 0.5rem; font-size: 0.85rem; }
  .presence-table { border-collapse: collapse; margin-top: 0.5rem; }
  .presence-table th, .presence-table td {
    padding: 0.3rem 0.7rem;
    border: 1px solid var(--color-border);
    text-align: left;
  }
  .presence-table-note {
    font-size: 0.78rem;
    color: var(--color-muted);
    margin-top: 0.5rem;
    max-width: 40rem;
  }
</style>
