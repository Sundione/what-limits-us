---
// Reproduces the paper's Figure 2 design with exact 1:1 PDF geometry, scale, and colors:
// - Samplings directly from sources/visualizations/basic_statistics/2026-05-25_limitation_section_presence_by_venue_and_year.pdf
// - Exact plot area (x=166.32..1890.55, y=100.18..1013.29, height=913.11)
// - Razor-sharp vector rendering and exact callout box placements
// - Fully interactive data exploration:
//     * Click any legend item to toggle series on/off (rotate data view)
//     * Hover any legend item to spotlight/isolate that series
//     * Preset filters (All, Adoption Rates Only, Paper Volumes Only, ACL Only, EMNLP Only)
//     * Interactive hover tooltips on bars and line markers with exact counts
import { presenceRows, adoptionPct, type PresenceRow } from "../data/limitationPresence";

const years = [2020, 2021, 2022, 2023, 2024, 2025];
const rowFor = (venue: PresenceRow["venue"], year: number) =>
  presenceRows.find((r) => r.venue === venue && r.year === year)!;

const COLORS = {
  aclDark: "#0072b2",
  aclLight: "#b6dbff",
  emnlpDark: "#e69f00",
  emnlpLight: "#ffe2b3",
  grid: "#e5e7eb",
  axisText: "#374151",
  axisTitle: "#111827",
};

// Exact Matplotlib PDF coordinates
const width = 2025;
const height = 1320;
const xMin = 166.32;
const xMax = 1890.55;
const plotW = xMax - xMin; // 1724.23
const yTop = 100.18;
const yBottom = 1013.29;
const plotH = yBottom - yTop; // 913.11

const countMax = 3500;
const pctMax = 100;

const slotW = plotW / years.length; // 287.37
const barW = 114.95;
const intraGap = 28.74;

const yForCount = (n: number) => yBottom - (n / countMax) * plotH;
const yForPct = (p: number) => yBottom - (p / pctMax) * plotH;

interface BarData {
  venue: PresenceRow["venue"];
  year: number;
  x: number;
  cx: number;
  hasY: number;
  hasH: number;
  noY: number;
  noH: number;
  row: PresenceRow;
  pct: number;
  hasSeries: string;
  noSeries: string;
}

const aclBars: BarData[] = years.map((year, i) => {
  const row = rowFor("ACL", year);
  const slotLeft = xMin + i * slotW;
  const x = slotLeft + intraGap;
  const cx = x + barW / 2;
  const hasY = yForCount(row.papersWithLimitations);
  const hasH = yBottom - hasY;
  const noY = yForCount(row.totalPapers);
  const noH = hasY - noY;
  return {
    venue: "ACL",
    year,
    x,
    cx,
    hasY,
    hasH,
    noY,
    noH,
    row,
    pct: adoptionPct(row),
    hasSeries: "acl-has",
    noSeries: "acl-no",
  };
});

const emnlpBars: BarData[] = years.map((year, i) => {
  const row = rowFor("EMNLP", year);
  const slotLeft = xMin + i * slotW;
  const x = slotLeft + intraGap + barW + intraGap;
  const cx = x + barW / 2;
  const hasY = yForCount(row.papersWithLimitations);
  const hasH = yBottom - hasY;
  const noY = yForCount(row.totalPapers);
  const noH = hasY - noY;
  return {
    venue: "EMNLP",
    year,
    x,
    cx,
    hasY,
    hasH,
    noY,
    noH,
    row,
    pct: adoptionPct(row),
    hasSeries: "emnlp-has",
    noSeries: "emnlp-no",
  };
});

const aclLinePoints = aclBars.map((b) => ({
  x: b.cx,
  y: yForPct(b.pct),
  pct: b.pct,
  row: b.row,
}));

const emnlpLinePoints = emnlpBars.map((b) => ({
  x: b.cx,
  y: yForPct(b.pct),
  pct: b.pct,
  row: b.row,
}));

const aclLine = aclLinePoints.map((p) => `${p.x.toFixed(2)},${p.y.toFixed(2)}`).join(" ");
const emnlpLine = emnlpLinePoints.map((p) => `${p.x.toFixed(2)},${p.y.toFixed(2)}`).join(" ");

// Top callout boxes (7 post-mandate boxes aligned cleanly near the top header, matching PDF)
const topCallouts = [
  { cx: emnlpBars[2].cx, y: 38, text: "97.8%", color: COLORS.emnlpDark, width: 112, series: "emnlp-line" },
  { cx: aclBars[3].cx,   y: 38, text: "98.9%", color: COLORS.aclDark,   width: 112, series: "acl-line" },
  { cx: emnlpBars[3].cx, y: 38, text: "99.2%", color: COLORS.emnlpDark, width: 112, series: "emnlp-line" },
  { cx: aclBars[4].cx,   y: 38, text: "99.4%", color: COLORS.aclDark,   width: 112, series: "acl-line" },
  { cx: emnlpBars[4].cx, y: 38, text: "99.9%", color: COLORS.emnlpDark, width: 112, series: "emnlp-line" },
  { cx: aclBars[5].cx,   y: 38, text: "99.6%", color: COLORS.aclDark,   width: 112, series: "acl-line" },
  { cx: emnlpBars[5].cx, y: 38, text: "100.0%", color: COLORS.emnlpDark, width: 128, series: "emnlp-line" },
];

// Bottom callout boxes (5 pre-mandate boxes, positioned above dots matching Figure 2 PDF)
const bottomCallouts = [
  { cx: aclBars[0].cx,   y: yForPct(2.4) - 48, text: "2.4%", color: COLORS.aclDark,   width: 96, series: "acl-line" },
  { cx: emnlpBars[0].cx, y: yForPct(4.8) - 48, text: "4.8%", color: COLORS.emnlpDark, width: 96, series: "emnlp-line" },
  { cx: aclBars[1].cx,   y: yForPct(2.9) - 48, text: "2.9%", color: COLORS.aclDark,   width: 96, series: "acl-line" },
  { cx: emnlpBars[1].cx, y: yForPct(4.2) - 48, text: "4.2%", color: COLORS.emnlpDark, width: 96, series: "emnlp-line" },
  { cx: aclBars[2].cx,   y: yForPct(9.1) - 48, text: "9.1%", color: COLORS.aclDark,   width: 96, series: "acl-line" },
];

const countGrid = [500, 1000, 1500, 2000, 2500, 3000, 3500];
const pctGrid = [0, 20, 40, 60, 80, 100];

function exploreUrl(year: number, venue: string) {
  return `${import.meta.env.BASE_URL}explore?year=${year}&venue=${venue}`;
}
---

<div class="presence-chart-wrapper" id="presence-chart-root">
  <!-- Interactive View Rotation Toolbar -->
  <div class="chart-toolbar" role="toolbar" aria-label="Interactive chart view options">
    <div class="toolbar-section">
      <span class="toolbar-label">Quick Views:</span>
      <div class="preset-buttons">
        <button type="button" class="preset-btn active" data-preset="all">Show All</button>
        <button type="button" class="preset-btn" data-preset="lines-only">Adoption Rates Only</button>
        <button type="button" class="preset-btn" data-preset="bars-only">Paper Volumes Only</button>
      </div>
    </div>

    <div class="toolbar-divider"></div>

    <div class="toolbar-section">
      <span class="toolbar-label">Conferences (Click to Toggle):</span>
      <div class="conf-toggles">
        <button type="button" class="conf-toggle-btn active" data-conf="acl" title="Toggle ACL bars and adoption line">
          <span class="conf-bullet" style="background-color: #0072b2;"></span>
          <span>ACL</span>
        </button>
        <button type="button" class="conf-toggle-btn active" data-conf="emnlp" title="Toggle EMNLP bars and adoption line">
          <span class="conf-bullet" style="background-color: #e69f00;"></span>
          <span>EMNLP</span>
        </button>
      </div>
    </div>
  </div>

  <div class="svg-container">
    <svg
      viewBox={`0 0 ${width} ${height}`}
      role="img"
      aria-label="Number and percentage of ACL and EMNLP papers with an explicit Limitations section, 2020 to 2025. Exact scale and proportions from paper Figure 2."
      class="presence-svg"
      text-rendering="geometricPrecision"
      shape-rendering="geometricPrecision"
    >
      <!-- Chart Canvas Background -->
      <rect width={width} height={height} fill="#ffffff" />

      <!-- Horizontal Gridlines & Left Y-Axis Tick Labels -->
      {countGrid.map((n) => (
        <g class="grid-row">
          <line x1={xMin} x2={xMax} y1={yForCount(n)} y2={yForCount(n)} stroke={COLORS.grid} stroke-width="1.6" />
          <text x={xMin - 20} y={yForCount(n)} class="axis-num" text-anchor="end" dominant-baseline="middle">{n}</text>
        </g>
      ))}
      <text x={xMin - 20} y={yForCount(0)} class="axis-num" text-anchor="end" dominant-baseline="middle">0</text>

      <!-- Right Y-Axis (% labels aligned directly with grid) -->
      {pctGrid.map((p) => (
        <text x={xMax + 22} y={yForPct(p)} class="axis-num" text-anchor="start" dominant-baseline="middle">{p}%</text>
      ))}

      <!-- Left Axis Title (Rotated 90 deg counter-clockwise) -->
      <text x={55} y={yTop + plotH / 2} class="axis-title" transform={`rotate(-90 55 ${yTop + plotH / 2})`} text-anchor="middle">
        Number of Papers
      </text>

      <!-- X-Axis Year Labels (Centered under each venue pair) -->
      {years.map((y, i) => (
        <text x={xMin + i * slotW + slotW / 2} y={yBottom + 52} class="axis-year" text-anchor="middle">
          {y}
        </text>
      ))}

      <!-- Stacked Bars (ACL & EMNLP) with interactive data attributes -->
      <g class="bars-layer">
        {[...aclBars, ...emnlpBars].map((bar) => {
          const tooltipPayload = JSON.stringify({
            venue: bar.venue,
            year: bar.year,
            total: bar.row.totalPapers,
            has: bar.row.papersWithLimitations,
            no: bar.row.totalPapers - bar.row.papersWithLimitations,
            pct: bar.pct.toFixed(1),
            failure: bar.row.extractionFailures,
            missing: bar.row.noExplicitLimitations,
            exploreUrl: exploreUrl(bar.year, bar.venue.toLowerCase()),
          });
          return (
            <g class="bar-group" data-year={bar.year} data-venue={bar.venue}>
              <!-- Has Limitations (dark lower segment) -->
              <g class="chart-elem bar-seg-interactive" data-series={bar.hasSeries} data-venue={bar.venue.toLowerCase()}>
                <rect
                  x={bar.x}
                  y={bar.hasY}
                  width={barW}
                  height={bar.hasH}
                  fill={bar.venue === "ACL" ? COLORS.aclDark : COLORS.emnlpDark}
                  class="bar-seg has-seg"
                  data-info={tooltipPayload}
                  tabindex="0"
                  role="link"
                  aria-label={`${bar.venue} ${bar.year}: ${bar.row.papersWithLimitations.toLocaleString()} papers with Limitations (${bar.pct.toFixed(1)}% adopted). Click to explore in Corpus.`}
                />
              </g>
              <!-- No Limitations (light upper segment) -->
              <g class="chart-elem bar-seg-interactive" data-series={bar.noSeries} data-venue={bar.venue.toLowerCase()}>
                <rect
                  x={bar.x}
                  y={bar.noY}
                  width={barW}
                  height={bar.noH}
                  fill={bar.venue === "ACL" ? COLORS.aclLight : COLORS.emnlpLight}
                  class="bar-seg no-seg"
                  data-info={tooltipPayload}
                  tabindex="0"
                  role="link"
                  aria-label={`${bar.venue} ${bar.year}: ${(bar.row.totalPapers - bar.row.papersWithLimitations).toLocaleString()} papers without Limitations. Click to explore in Corpus.`}
                />
              </g>
            </g>
          );
        })}
      </g>

      <!-- Solid Adoption Rate Lines -->
      <g class="lines-layer">
        <!-- ACL adoption line -->
        <polyline
          points={aclLine}
          stroke={COLORS.aclDark}
          stroke-width="5"
          fill="none"
          stroke-linejoin="round"
          stroke-linecap="round"
          class="chart-elem series-line"
          data-series="acl-line"
        />
        <!-- EMNLP adoption line -->
        <polyline
          points={emnlpLine}
          stroke={COLORS.emnlpDark}
          stroke-width="5"
          fill="none"
          stroke-linejoin="round"
          stroke-linecap="round"
          class="chart-elem series-line"
          data-series="emnlp-line"
        />

        <!-- Line Dots -->
        {aclLinePoints.map((p) => {
          const tooltipPayload = JSON.stringify({
            venue: p.row.venue,
            year: p.row.year,
            total: p.row.totalPapers,
            has: p.row.papersWithLimitations,
            pct: p.pct.toFixed(1),
            failure: p.row.extractionFailures,
            missing: p.row.noExplicitLimitations,
            exploreUrl: exploreUrl(p.row.year, "acl"),
          });
          return (
            <circle
              cx={p.x}
              cy={p.y}
              r="9"
              fill={COLORS.aclDark}
              class="chart-elem line-marker"
              data-series="acl-line"
              data-info={tooltipPayload}
              tabindex="0"
              role="link"
              aria-label={`ACL ${p.row.year}: ${p.pct.toFixed(1)}% adoption. Click to explore in Corpus.`}
            />
          );
        })}
        {emnlpLinePoints.map((p) => {
          const tooltipPayload = JSON.stringify({
            venue: p.row.venue,
            year: p.row.year,
            total: p.row.totalPapers,
            has: p.row.papersWithLimitations,
            pct: p.pct.toFixed(1),
            failure: p.row.extractionFailures,
            missing: p.row.noExplicitLimitations,
            exploreUrl: exploreUrl(p.row.year, "emnlp"),
          });
          return (
            <circle
              cx={p.x}
              cy={p.y}
              r="9"
              fill={COLORS.emnlpDark}
              class="chart-elem line-marker"
              data-series="emnlp-line"
              data-info={tooltipPayload}
              tabindex="0"
              role="link"
              aria-label={`EMNLP ${p.row.year}: ${p.pct.toFixed(1)}% adoption. Click to explore in Corpus.`}
            />
          );
        })}
      </g>

      <!-- Top Callout Boxes (Sharp 3px borders matching PDF) -->
      <g class="callouts-layer">
        {topCallouts.map((c) => (
          <g class="chart-elem callout-group" data-series={c.series} transform={`translate(${c.cx}, 0)`}>
            <rect
              x={-c.width / 2}
              y={c.y}
              width={c.width}
              height="48"
              fill="#ffffff"
              stroke={c.color}
              stroke-width="3"
              rx="0"
            />
            <text
              x="0"
              y={c.y + 33}
              text-anchor="middle"
              class="callout-txt"
              fill={c.color}
            >
              {c.text}
            </text>
          </g>
        ))}

        <!-- Bottom Callout Boxes (Pre-mandate years) -->
        {bottomCallouts.map((c) => (
          <g class="chart-elem callout-group" data-series={c.series} transform={`translate(${c.cx}, 0)`}>
            <rect
              x={-c.width / 2}
              y={c.y}
              width={c.width}
              height="48"
              fill="#ffffff"
              stroke={c.color}
              stroke-width="3"
              rx="0"
            />
            <text
              x="0"
              y={c.y + 33}
              text-anchor="middle"
              class="callout-txt"
              fill={c.color}
            >
              {c.text}
            </text>
          </g>
        ))}
      </g>

      <!-- Interactive 3-Row Legend Matching Paper Figure 2 Exactly -->
      <!-- Clicking any legend button toggles its series visibility -->
      <g class="chart-legend-svg" transform="translate(0, 1140)">
        <!-- Column 1: ACL Series (x=410) -->
        <!-- Row 1: ACL Has Limitations -->
        <g class="legend-item" data-series-id="acl-has" transform="translate(410, 0)" tabindex="0" role="button" aria-label="Toggle ACL Has Limitations">
          <rect x="-10" y="-8" width="500" height="44" fill="transparent" cursor="pointer" />
          <rect x="0" y="0" width="30" height="30" fill={COLORS.aclDark} class="legend-icon" />
          <text x="46" y="23" class="legend-txt">ACL &mdash; Has Limitations Section</text>
        </g>
        <!-- Row 2: ACL No Limitations -->
        <g class="legend-item" data-series-id="acl-no" transform="translate(410, 52)" tabindex="0" role="button" aria-label="Toggle ACL No Limitations">
          <rect x="-10" y="-8" width="500" height="44" fill="transparent" cursor="pointer" />
          <rect x="0" y="0" width="30" height="30" fill={COLORS.aclLight} class="legend-icon" />
          <text x="46" y="23" class="legend-txt">ACL &mdash; No Limitations Section</text>
        </g>
        <!-- Row 3: ACL % Adoption -->
        <g class="legend-item" data-series-id="acl-line" transform="translate(410, 104)" tabindex="0" role="button" aria-label="Toggle ACL % Adoption">
          <rect x="-10" y="-8" width="500" height="44" fill="transparent" cursor="pointer" />
          <line x1="0" y1="15" x2="36" y2="15" stroke={COLORS.aclDark} stroke-width="5" class="legend-line" />
          <circle cx="18" cy="15" r="9" fill={COLORS.aclDark} class="legend-dot" />
          <text x="50" y="23" class="legend-txt">ACL &mdash; % Adoption</text>
        </g>

        <!-- Column 2: EMNLP Series (x=1150) -->
        <!-- Row 1: EMNLP Has Limitations -->
        <g class="legend-item" data-series-id="emnlp-has" transform="translate(1150, 0)" tabindex="0" role="button" aria-label="Toggle EMNLP Has Limitations">
          <rect x="-10" y="-8" width="500" height="44" fill="transparent" cursor="pointer" />
          <rect x="0" y="0" width="30" height="30" fill={COLORS.emnlpDark} class="legend-icon" />
          <text x="46" y="23" class="legend-txt">EMNLP &mdash; Has Limitations Section</text>
        </g>
        <!-- Row 2: EMNLP No Limitations -->
        <g class="legend-item" data-series-id="emnlp-no" transform="translate(1150, 52)" tabindex="0" role="button" aria-label="Toggle EMNLP No Limitations">
          <rect x="-10" y="-8" width="500" height="44" fill="transparent" cursor="pointer" />
          <rect x="0" y="0" width="30" height="30" fill={COLORS.emnlpLight} class="legend-icon" />
          <text x="46" y="23" class="legend-txt">EMNLP &mdash; No Limitations Section</text>
        </g>
        <!-- Row 3: EMNLP % Adoption -->
        <g class="legend-item" data-series-id="emnlp-line" transform="translate(1150, 104)" tabindex="0" role="button" aria-label="Toggle EMNLP % Adoption">
          <rect x="-10" y="-8" width="500" height="44" fill="transparent" cursor="pointer" />
          <line x1="0" y1="15" x2="36" y2="15" stroke={COLORS.emnlpDark} stroke-width="5" class="legend-line" />
          <circle cx="18" cy="15" r="9" fill={COLORS.emnlpDark} class="legend-dot" />
          <text x="50" y="23" class="legend-txt">EMNLP &mdash; % Adoption</text>
        </g>
      </g>
    </svg>

    <!-- Floating Interactive Data Readout Tooltip -->
    <div id="chart-floating-tooltip" class="chart-floating-tooltip" role="tooltip" aria-hidden="true" style="display: none;">
      <div class="tooltip-header">
        <span class="tooltip-venue-badge" id="tt-badge"></span>
        <span class="tooltip-pct" id="tt-pct"></span>
      </div>
      <div class="tooltip-body">
        <div class="tt-row"><span class="tt-lbl">Total Papers:</span><strong id="tt-total"></strong></div>
        <div class="tt-row"><span class="tt-lbl">Has Limitations:</span><strong id="tt-has" class="text-blue"></strong></div>
        <div class="tt-row"><span class="tt-lbl">No Limitations:</span><strong id="tt-no"></strong></div>
        <div class="tt-subrow" id="tt-breakdown"></div>
      </div>
      <div class="tooltip-cta">Click bar to browse papers &rarr;</div>
    </div>
  </div>

  <p class="presence-caption">
    <strong>Interactive Tip:</strong> Click any item in the legend below to toggle that bar segment or line on/off. Hover over a legend item to isolate that specific data stream. From EMNLP 2022 onward, the % adoption line reflects policy adoption (&ldquo;pipeline failures&rdquo; are inconclusive and not counted as non-adopters).
  </p>

  <details class="presence-table-details">
    <summary>View exact counts table</summary>
    <table class="presence-table">
      <thead>
        <tr>
          <th>Venue</th><th>Year</th><th>Total papers</th><th>Has Limitations</th>
          <th>Pipeline failure</th><th>Truly missing</th><th>Adoption %</th>
        </tr>
      </thead>
      <tbody>
        {presenceRows.map((row) => (
          <tr>
            <td><strong>{row.venue}</strong></td>
            <td>{row.year}</td>
            <td>{row.totalPapers.toLocaleString()}</td>
            <td>{row.papersWithLimitations.toLocaleString()}</td>
            <td>{row.extractionFailures === null ? "—" : row.extractionFailures.toLocaleString()}</td>
            <td>{row.noExplicitLimitations === null ? "—" : row.noExplicitLimitations.toLocaleString()}</td>
            <td><strong>{adoptionPct(row).toFixed(1)}%</strong></td>
          </tr>
        ))}
      </tbody>
    </table>
    <p class="presence-table-note">
      &ldquo;Pipeline failure&rdquo; = extraction pipeline could not parse PDF (inconclusive). &ldquo;Truly missing&rdquo; = verified to lack a section. Only tracked from EMNLP 2022 onward. From paper Section 4.1 / Table 3.
    </p>
  </details>
</div>

<script>
  function initPresenceChartInteractivity() {
    const root = document.getElementById("presence-chart-root");
    if (!root) return;

    const svg = root.querySelector(".presence-svg");
    const tooltip = document.getElementById("chart-floating-tooltip");
    const ttBadge = document.getElementById("tt-badge");
    const ttPct = document.getElementById("tt-pct");
    const ttTotal = document.getElementById("tt-total");
    const ttHas = document.getElementById("tt-has");
    const ttNo = document.getElementById("tt-no");
    const ttBreakdown = document.getElementById("tt-breakdown");
    const presetButtons = root.querySelectorAll(".preset-btn");
    const legendItems = root.querySelectorAll(".legend-item");
    const chartElems = root.querySelectorAll(".chart-elem");

    // State of active series
    const activeSeries: Record<string, boolean> = {
      "acl-has": true,
      "acl-no": true,
      "acl-line": true,
      "emnlp-has": true,
      "emnlp-no": true,
      "emnlp-line": true,
    };

    function updateSeriesVisibility() {
      chartElems.forEach((el) => {
        const series = el.getAttribute("data-series");
        if (!series) return;
        const isVisible = activeSeries[series] !== false;
        el.classList.toggle("is-hidden", !isVisible);
      });

      legendItems.forEach((item) => {
        const sId = item.getAttribute("data-series-id");
        if (!sId) return;
        const isVisible = activeSeries[sId] !== false;
        item.classList.toggle("is-disabled", !isVisible);
      });
    }

    const confButtons = root.querySelectorAll(".conf-toggle-btn");

    function syncButtonsState() {
      const aclActive = activeSeries["acl-has"] || activeSeries["acl-line"];
      const emnlpActive = activeSeries["emnlp-has"] || activeSeries["emnlp-line"];

      confButtons.forEach((btn) => {
        const c = btn.getAttribute("data-conf");
        if (c === "acl") btn.classList.toggle("active", Boolean(aclActive));
        if (c === "emnlp") btn.classList.toggle("active", Boolean(emnlpActive));
      });
    }

    function toggleConference(conf: "acl" | "emnlp") {
      const isCurrentlyActive = conf === "acl"
        ? (activeSeries["acl-has"] || activeSeries["acl-line"])
        : (activeSeries["emnlp-has"] || activeSeries["emnlp-line"]);
      const nextState = !isCurrentlyActive;

      if (conf === "acl") {
        activeSeries["acl-has"] = nextState;
        activeSeries["acl-no"] = nextState;
        activeSeries["acl-line"] = nextState;
      } else {
        activeSeries["emnlp-has"] = nextState;
        activeSeries["emnlp-no"] = nextState;
        activeSeries["emnlp-line"] = nextState;
      }

      // clear preset active state
      presetButtons.forEach((b) => b.classList.remove("active"));
      syncButtonsState();
      updateSeriesVisibility();
    }

    confButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const conf = btn.getAttribute("data-conf") as "acl" | "emnlp";
        if (conf) toggleConference(conf);
      });
    });

    // Chart element click: Navigate to Explore corpus for that venue & year
    const clickableChartElements = root.querySelectorAll(".bar-seg, .line-marker");
    clickableChartElements.forEach((el) => {
      el.addEventListener("click", (e) => {
        e.stopPropagation();
        const dInfo = el.getAttribute("data-info");
        if (!dInfo) return;
        try {
          const d = JSON.parse(dInfo);
          if (d.exploreUrl) {
            window.location.href = d.exploreUrl;
          }
        } catch (err) {}
      });
      el.addEventListener("keydown", (e: any) => {
        if (e.key === "Enter" || e.key === " ") {
          e.preventDefault();
          el.dispatchEvent(new MouseEvent("click", { bubbles: true }));
        }
      });
    });

    // Legend Click Toggle
    legendItems.forEach((item) => {
      const sId = item.getAttribute("data-series-id");
      if (!sId) return;

      const toggle = () => {
        activeSeries[sId] = !activeSeries[sId];
        presetButtons.forEach((b) => b.classList.remove("active"));
        syncButtonsState();
        updateSeriesVisibility();
      };

      item.addEventListener("click", toggle);
      item.addEventListener("keydown", (e: any) => {
        if (e.key === "Enter" || e.key === " ") {
          e.preventDefault();
          toggle();
        }
      });

      // Legend Hover Spotlight / Focus Isolation
      item.addEventListener("mouseenter", () => {
        if (!activeSeries[sId]) return;
        chartElems.forEach((el) => {
          const s = el.getAttribute("data-series");
          if (s && s !== sId) {
            el.classList.add("is-dimmed");
          }
        });
      });

      item.addEventListener("mouseleave", () => {
        chartElems.forEach((el) => el.classList.remove("is-dimmed"));
      });
    });

    // Preset Filter Views
    presetButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        presetButtons.forEach((b) => b.classList.remove("active"));
        btn.classList.add("active");
        const preset = btn.getAttribute("data-preset");

        if (preset === "all") {
          Object.keys(activeSeries).forEach((k) => (activeSeries[k] = true));
        } else if (preset === "lines-only") {
          activeSeries["acl-has"] = false;
          activeSeries["acl-no"] = false;
          activeSeries["emnlp-has"] = false;
          activeSeries["emnlp-no"] = false;
          activeSeries["acl-line"] = true;
          activeSeries["emnlp-line"] = true;
        } else if (preset === "bars-only") {
          activeSeries["acl-has"] = true;
          activeSeries["acl-no"] = true;
          activeSeries["emnlp-has"] = true;
          activeSeries["emnlp-no"] = true;
          activeSeries["acl-line"] = false;
          activeSeries["emnlp-line"] = false;
        }

        syncButtonsState();
        updateSeriesVisibility();
      });
    });

    // Interactive Hover Tooltip for Bars & Points
    const interactiveTargets = root.querySelectorAll("[data-info]");
    const container = root.querySelector(".svg-container") as HTMLElement;

    function showTooltip(el: Element) {
      const raw = el.getAttribute("data-info");
      if (!raw || !tooltip || !container) return;

      try {
        const d = JSON.parse(raw);
        if (ttBadge) {
          ttBadge.textContent = `${d.venue} ${d.year}`;
          ttBadge.style.backgroundColor = d.venue === "ACL" ? "#0072b2" : "#e69f00";
        }
        if (ttPct) ttPct.textContent = `${d.pct}% adopted`;
        if (ttTotal) ttTotal.textContent = Number(d.total).toLocaleString();
        if (ttHas) ttHas.textContent = Number(d.has).toLocaleString();
        if (ttNo) ttNo.textContent = Number(d.no).toLocaleString();

        if (ttBreakdown) {
          if (d.failure !== null && d.missing !== null && d.failure !== undefined) {
            ttBreakdown.innerHTML = `(incl. ${Number(d.failure).toLocaleString()} extraction failures &bull; ${Number(d.missing).toLocaleString()} truly missing)`;
          } else {
            ttBreakdown.innerHTML = "";
          }
        }

        const cRect = container.getBoundingClientRect();
        const elRect = el.getBoundingClientRect();

        const x = elRect.left - cRect.left + elRect.width / 2;
        const y = elRect.top - cRect.top;

        const clampedX = Math.max(140, Math.min(cRect.width - 140, x));
        tooltip.style.left = `${clampedX}px`;

        if (y < 160) {
          tooltip.style.top = `${elRect.bottom - cRect.top + 12}px`;
          tooltip.classList.add("flipped-below");
        } else {
          tooltip.style.top = `${y - 12}px`;
          tooltip.classList.remove("flipped-below");
        }

        tooltip.style.display = "block";
        tooltip.classList.add("is-visible");
        tooltip.setAttribute("aria-hidden", "false");
      } catch (e) {
        console.error(e);
      }
    }

    function hideTooltip() {
      if (!tooltip) return;
      tooltip.classList.remove("is-visible");
      tooltip.style.display = "none";
      tooltip.setAttribute("aria-hidden", "true");
    }

    if (svg) {
      svg.addEventListener("pointerover", (e: any) => {
        const target = e.target?.closest?.("[data-info]");
        if (target) showTooltip(target);
      });
      svg.addEventListener("pointerout", (e: any) => {
        const related = e.relatedTarget as Element | null;
        if (!related || !related.closest?.("[data-info]")) {
          hideTooltip();
        }
      });
    }

    interactiveTargets.forEach((t) => {
      t.addEventListener("focusin", () => showTooltip(t));
      t.addEventListener("focusout", hideTooltip);
    });

    updateSeriesVisibility();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initPresenceChartInteractivity);
  } else {
    initPresenceChartInteractivity();
  }
  document.addEventListener("astro:page-load", initPresenceChartInteractivity);
</script>

