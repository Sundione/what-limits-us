---
import "@fontsource-variable/inter";
import "../styles/theme.css";
import "../styles/shadcn.css";
import { House, Workflow, BookOpen, Search, ChartColumn, Sun, Moon } from "lucide-preact";
import LogoMark from "../components/LogoMark.astro";
import BrandIcon from "../components/BrandIcon.astro";
import { paper } from "../data/paper";

interface Props {
  title: string;
  description?: string;
}
const { title, description = "NLP Limitations — Companion site for \"What Limits Us? Analyzing Self-Reported Limitations in NLP Research\" (EMNLP 2026 Findings)." } = Astro.props;

const currentPath = Astro.url.pathname;
const baseUrl = import.meta.env.BASE_URL;

const navItems = [
  { href: baseUrl, label: "Overview", icon: "overview", key: "overview" },
  { href: `${baseUrl}methodology`, label: "Methodology", icon: "methodology", key: "methodology" },
  { href: `${baseUrl}codebook`, label: "Codebook", icon: "codebook", key: "codebook" },
  { href: `${baseUrl}explore`, label: "Explore", icon: "explore", badge: "16k", key: "explore" },
  { href: `${baseUrl}results`, label: "Results", icon: "results", key: "results" },
];

const ogImage = new URL(`${baseUrl}og-image.png`, Astro.site).href;
const navIcons = { overview: House, methodology: Workflow, codebook: BookOpen, explore: Search, results: ChartColumn };

const isItemActive = (key: string) => {
  if (key === "overview") {
    const normalized = currentPath.replace(/\/index\.html$/, "").replace(/\/$/, "");
    const normalizedBase = baseUrl.replace(/\/$/, "");
    return normalized === normalizedBase;
  }
  return currentPath.includes(`/${key}`);
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href={`${baseUrl}favicon.svg`} type="image/svg+xml" />
    <link rel="icon" href={`${baseUrl}favicon-32.png`} sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href={`${baseUrl}apple-touch-icon.png`} />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="NLP Limitations" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
    <script is:inline>
      // Apply a saved theme choice before first paint (no flash). Without a
      // saved choice the CSS follows the OS via prefers-color-scheme.
      try {
        var t = localStorage.getItem("theme");
        if (t === "light" || t === "dark") document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
  </head>
  <body>
    <header class="site-header">
      <nav aria-label="Main Navigation">
        <a class="brand" href={baseUrl} aria-label="NLP Limitations, home">
          <LogoMark size={30} />
          <span class="brand-title"><span class="brand-title-nlp">NLP</span> Limitations</span>
        </a>

        <div class="nav-links" role="menubar">
          {navItems.map((item) => {
            const active = isItemActive(item.key);
            return (
              <a
                href={item.href}
                class={`nav-item ${active ? "active" : ""}`}
                aria-current={active ? "page" : undefined}
                role="menuitem"
              >
                {(() => {
                  const Icon = navIcons[item.icon as keyof typeof navIcons];
                  return <Icon class="nav-icon" size={16} strokeWidth={2} aria-hidden="true" />;
                })()}
                <span class="nav-label">{item.label}</span>
                {item.badge && <span class="nav-badge">{item.badge}</span>}
              </a>
            );
          })}
        </div>

        <div class="nav-actions">
          <a
            class="nav-action-btn"
            href={paper.links.arxiv}
            target="_blank"
            rel="noopener noreferrer"
            title="Read paper on arXiv"
          >
            <BrandIcon name="arxiv" size={15} class="action-icon" />
            <span>arXiv</span>
          </a>
          <a
            class="nav-action-btn"
            href={paper.links.datasetGithub}
            target="_blank"
            rel="noopener noreferrer"
            title="View dataset repository on GitHub"
          >
            <BrandIcon name="github" size={15} class="action-icon" />
            <span>GitHub</span>
          </a>
          <button type="button" class="theme-toggle" aria-label="Toggle dark mode" title="Toggle dark mode">
            <Moon class="theme-icon-moon" size={16} aria-hidden="true" />
            <Sun class="theme-icon-sun" size={16} aria-hidden="true" />
          </button>
        </div>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="footer-inner">
        <div class="footer-meta">
          <span class="footer-brand">
            <LogoMark size={20} />
            <strong>NLP Limitations</strong>
          </span>
          <span class="footer-sep">&bull;</span>
          <span class="footer-context">Companion site for an EMNLP 2026 Findings paper</span>
        </div>
        <div class="footer-license">
          <span class="license-label">Dataset released under</span>
          <a
            href="https://creativecommons.org/licenses/by/4.0/"
            target="_blank"
            rel="noopener noreferrer"
            class="license-link"
            title="Creative Commons Attribution 4.0 International"
          >
            <svg class="license-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"></circle>
              <path d="M14.5 9a3.5 3.5 0 0 0-5 0v6a3.5 3.5 0 0 0 5 0"></path>
            </svg>
            <span>CC BY 4.0</span>
          </a>
        </div>
      </div>
    </footer>
    <script>
      // Theme toggle: flips the effective theme and remembers the choice.
      const toggle = document.querySelector<HTMLButtonElement>(".theme-toggle");
      toggle?.addEventListener("click", () => {
        const root = document.documentElement;
        const current = root.dataset.theme ?? (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
        const next = current === "dark" ? "light" : "dark";
        root.dataset.theme = next;
        try {
          localStorage.setItem("theme", next);
        } catch {}
      });

      // Scroll-spy for in-page sub-navs (methodology, results): marks the
      // section currently under the sticky header as active.
      const links = [...document.querySelectorAll<HTMLAnchorElement>('.subnav-links a[href^="#"]')];
      const targets = links
        .map((a) => document.getElementById(a.hash.slice(1)))
        .filter((el): el is HTMLElement => el !== null);
      if (targets.length) {
        let currentId = "";
        const update = () => {
          const headerH = parseFloat(getComputedStyle(document.documentElement).getPropertyValue("--header-h")) || 65;
          let current = targets[0];
          for (const t of targets) {
            if (t.getBoundingClientRect().top - (headerH + 90) <= 0) current = t;
          }
          if (current.id === currentId) return;
          currentId = current.id;
          for (const a of links) {
            const on = a.hash === `#${current.id}`;
            a.classList.toggle("is-active", on);
            if (on) {
              a.setAttribute("aria-current", "location");
              // Keep the active pill visible when the sub-nav scrolls sideways on phones.
              const strip = a.closest<HTMLElement>(".methodology-subnav-inner, .results-subnav-inner");
              if (strip) {
                const ar = a.getBoundingClientRect();
                const sr = strip.getBoundingClientRect();
                if (ar.left < sr.left || ar.right > sr.right) {
                  strip.scrollBy({ left: ar.left - sr.left - 16, behavior: "smooth" });
                }
              }
            } else {
              a.removeAttribute("aria-current");
            }
          }
        };
        addEventListener("scroll", update, { passive: true });
        update();
      }
    </script>
  </body>
</html>

<style is:global>
  :root {
    /* Colours live in src/styles/theme.css (light + dark tokens). */
    --max-width: 1040px;
    --nav-max-width: 1360px;
    /* Height of the sticky site header; page sub-navs stick just below it. */
    --header-h: 65px;
  }

  * { box-sizing: border-box; }

  body {
    margin: 0;
    background: var(--color-bg);
    color: var(--color-text);
    font-family: var(--font-sans);
    line-height: 1.55;
    -webkit-font-smoothing: antialiased;
    font-feature-settings: "cv11", "ss01";
  }

  :focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 2px;
  }

  code, pre, kbd {
    font-family: var(--font-mono);
  }

  a { color: var(--color-accent); }

  /* ---------------- Header (shadcn-style) ---------------- */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 1000;
    background: var(--header-bg);
    backdrop-filter: saturate(180%) blur(12px);
    -webkit-backdrop-filter: saturate(180%) blur(12px);
    border-bottom: 1px solid var(--border);
  }

  .site-header nav {
    max-width: var(--nav-max-width);
    margin: 0 auto;
    padding: 0.75rem 1.75rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    min-height: 64px;
  }

  /* Brand */
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    flex-shrink: 0;
  }
  .brand-title {
    color: var(--foreground);
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .brand-title-nlp {
    color: var(--primary-text);
  }

  /* Nav links: quiet text links, active page in full ink */
  .nav-links {
    display: flex;
    align-items: center;
    gap: 0.15rem;
  }
  .nav-item {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.4rem 0.75rem;
    border-radius: var(--radius-sm);
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--muted-foreground);
    transition: color 0.15s ease, background-color 0.15s ease;
    white-space: nowrap;
  }
  .nav-item:hover {
    color: var(--foreground);
    background: var(--muted);
    text-decoration: none;
  }
  .nav-item.active {
    color: var(--foreground);
    background: var(--muted);
    font-weight: 600;
  }
  .nav-icon {
    flex-shrink: 0;
  }
  .nav-badge {
    font-size: 0.68rem;
    font-weight: 600;
    line-height: 1.3;
    color: var(--primary-strong);
    background: var(--primary-soft);
    border: 1px solid var(--primary-border);
    padding: 0 0.35rem;
    border-radius: 999px;
    font-variant-numeric: tabular-nums;
  }

  /* Right-side actions: outline buttons + icon-only theme toggle */
  .nav-actions {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    flex-shrink: 0;
  }
  .nav-action-btn,
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    height: 2.25rem;
    padding: 0 0.75rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    font: inherit;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--foreground);
    text-decoration: none;
    background: var(--background);
    box-shadow: var(--shadow-xs);
    cursor: pointer;
    transition: background-color 0.15s ease, border-color 0.15s ease;
  }
  .nav-action-btn:hover,
  .theme-toggle:hover {
    background: var(--muted);
    text-decoration: none;
  }
  .theme-toggle {
    width: 2.25rem;
    padding: 0;
  }
  .action-icon {
    flex-shrink: 0;
  }
  /* Show the icon for the theme you would switch TO */
  .theme-icon-sun {
    display: none;
  }
  :root[data-theme="dark"] .theme-icon-sun {
    display: block;
  }
  :root[data-theme="dark"] .theme-icon-moon {
    display: none;
  }
  @media (prefers-color-scheme: dark) {
    :root:where(:not([data-theme="light"])) .theme-icon-sun {
      display: block;
    }
    :root:where(:not([data-theme="light"])) .theme-icon-moon {
      display: none;
    }
  }

  /* Main & Layout */
  main {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 2.25rem 1.25rem 4rem;
  }

  .site-footer {
    border-top: 1px solid var(--color-border);
    color: var(--color-muted);
    font-size: 0.88rem;
    background: var(--surface);
    margin-top: 3rem;
  }
  .site-footer .footer-inner {
    max-width: var(--nav-max-width);
    margin: 0 auto;
    padding: 1.5rem 1.75rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.85rem 2rem;
  }
  .footer-meta {
    display: inline-flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.55rem;
    font-size: 0.86rem;
  }
  .footer-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--foreground);
  }
  .footer-sep {
    color: var(--muted-foreground-faint);
    font-weight: bold;
  }
  .footer-context {
    color: var(--color-muted);
  }
  .footer-license {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--color-muted);
    font-size: 0.85rem;
  }
  .license-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.22rem 0.6rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border);
    background: var(--card);
    color: var(--color-text);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.8rem;
    transition: all 0.15s ease;
  }
  .license-link:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
    background: var(--primary-soft);
    text-decoration: none;
  }
  .license-icon {
    flex-shrink: 0;
    color: var(--color-muted);
  }
  .license-link:hover .license-icon {
    color: var(--color-accent);
  }

  .badge {
    display: inline-block;
    padding: 0.15rem 0.55rem;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 600;
  }
  .badge-llm { background: var(--llm-bg); color: var(--llm-fg); border: 1px solid var(--llm-border); }
  .badge-human { background: var(--human-bg); color: var(--human-fg); border: 1px solid var(--human-border); }

  /* Responsive Navbar */
  @media (max-width: 960px) {
    :root {
      --header-h: 107px;
    }
    .site-header nav {
      padding: 0.65rem 1rem;
      flex-wrap: wrap;
      gap: 0.65rem;
    }
    .brand-venue-tag {
      display: none;
    }
    /* arXiv / GitHub stay reachable as icon-only buttons */
    .nav-action-btn {
      width: 2.25rem;
      padding: 0;
    }
    .nav-action-btn span {
      display: none;
    }
    .nav-links {
      order: 3;
      width: 100%;
      justify-content: center;
      padding: 0.2rem;
    }
    .nav-item {
      padding: 0.32rem 0.65rem;
      font-size: 0.82rem;
    }
  }

  /* Phones: the five sections move to a fixed bottom tab bar so none of
     them (especially Explore) is ever scrolled out of view. */
  @media (max-width: 640px) {
    :root {
      --header-h: 59px;
    }
    body {
      padding-bottom: calc(58px + env(safe-area-inset-bottom));
    }
    .brand-title {
      font-size: 1.2rem;
    }
    .nav-links {
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 1000;
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: 0;
      width: auto;
      padding: 0.25rem 0.25rem calc(0.25rem + env(safe-area-inset-bottom));
      border: 0;
      border-top: 1px solid var(--color-border);
      border-radius: 0;
      background: var(--header-bg);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
    }
    .nav-item {
      flex-direction: column;
      justify-content: center;
      gap: 0.18rem;
      min-height: 48px;
      padding: 0.3rem 0.1rem;
      font-size: 0.7rem;
    }
    .nav-item.active {
      background: var(--primary-soft);
      color: var(--primary-strong);
    }
    .nav-icon {
      width: 20px;
      height: 20px;
    }
    .nav-badge {
      display: none;
    }
  }
</style>
